// ---- UI ----
DEFINE_UI_PARAMS(input_gamut_heal, Input / Fix, DCTLUI_COMBO_BOX, 0, {heal_off,heal_aces_rgc},{Off,ACES 1.3 RGC})
DEFINE_UI_PARAMS(diag_view, View / Mode, DCTLUI_COMBO_BOX, 0, {view_result,view_neutral,view_density,view_gamut,view_skin},{Result,Neutral Chroma,Density,Gamut Stress,Skin Mask})

DEFINE_UI_PARAMS(temp, WB / Temp K, DCTLUI_SLIDER_FLOAT, 6504.0, 2500.0, 20000.0, 25.0)
DEFINE_UI_PARAMS(tint, WB / Tint, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 0.1)

// Camera spectral-cut controls. The source model is spectral; Keystone uses an explicitly
// documented RGB projection because a DCTL has no wavelength-resolved film sensitivity.

// Existing negative-space RGB printer-light trims. Neutral = 25.
