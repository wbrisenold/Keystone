// Keystone v1.13.1
// DaVinci Resolve DCTL grading tool for ARRI Wide Gamut 3 / LogC3 EI800.
//
// Working domain:
//   Input and output: AWG3 / LogC3 EI800
//   Internal scene processing: AWG3 linear / XYZ D65 / Oklab as appropriate
//
// Main controls:
//   Input Repair
//   HDR-style WB Hue / Amount
//   Film-negative printer lights
//   Exposure / Primera Black Point / Primera Contrast / Shadows / Highlights / Roll Off
//   Primera Pos Saturation
//   White / Black cleanup
//
// Current processing order:
//   Input Repair
//   -> WB
//   -> Exposure
//   -> Printer Lights
//   -> Black
//   -> Daniele Contrast
//   -> Shadows / Highlights
//   -> Roll Off
//   -> Pos Saturation
//   -> Oklab Pos Saturation
//   -> Skin Controls
//   -> White Clean / Black Clean
//   -> Technical Safety
//   -> LogC3 EI800
//
// Creative defaults are intended as a direct bypass.
// Keystone does NOT include an ODT.
//
// Third-party notices are included in THIRD_PARTY_NOTICES.md.
// The Daniele tone-scale core follows Thatcher Freeman's MIT-licensed
// utility-dctls implementation, based on Daniele Siragusano's tone-scale proposal.
// The optional input repair implements an ACES 1.3 Reference Gamut Compression core.
// Skin-control design was informed by the MIT-licensed PrimeraSkin workflow.
//
// Runtime note:
// Static validation cannot replace compiling this file inside DaVinci Resolve.
// See tools/validate.py and .github/workflows/validate.yml.

// ---- ARRI Wide Gamut 3 -> XYZ D65 ----
#define R2_C0 make_float3(0.638008f,0.291954f,0.002798f)
#define R2_C1 make_float3(0.214704f,0.823841f,-0.067034f)
#define R2_C2 make_float3(0.097744f,-0.115795f,1.153294f)

// ---- Bradford CAT + D65 reference white ----
#define WHITE_D65 make_float3(0.9504559271f,1.0f,1.0890577508f)
#define BRADFORD_C0 make_float3(0.8951000000f,-0.7502000000f,0.0389000000f)
#define BRADFORD_C1 make_float3(0.2664000000f,1.7135000000f,-0.0685000000f)
#define BRADFORD_C2 make_float3(-0.1614000000f,0.0367000000f,1.0296000000f)
#define BRADFORD_INV_C0 make_float3(0.9869929055f,0.4323052697f,-0.0085286646f)
#define BRADFORD_INV_C1 make_float3(-0.1470542564f,0.5183602715f,0.0400428217f)
#define BRADFORD_INV_C2 make_float3(0.1599626517f,0.0492912282f,0.9684866958f)

// ---- XYZ D65 -> ARRI Wide Gamut 3 ----
#define G2_C0 make_float3(1.789064538025f,-0.639848741771f,-0.041530974004f)
#define G2_C1 make_float3(-0.482533816466f,1.396400099532f,0.082334958727f)
#define G2_C2 make_float3(-0.200075026387f,0.194432230586f,0.878868163772f)

// ---- OKLab: XYZ D65 <-> OKLab direct precombined matrices ----
// Direct XYZ D65 <-> Oklab matrices used by the active perceptual operators.
#define X65_TO_OKLMS_C0 make_float3(0.8190224432f,0.0329836672f,0.0481771996f)
#define X65_TO_OKLMS_C1 make_float3(0.3619062563f,0.9292868469f,0.2642395197f)
#define X65_TO_OKLMS_C2 make_float3(-0.1288737826f,0.0361446682f,0.6335478285f)
#define OKLMS3_TO_X65_C0 make_float3(1.2268798734f,-0.0405757646f,-0.0763729497f)
#define OKLMS3_TO_X65_C1 make_float3(-0.5578150037f,1.1122868294f,-0.4214933239f)
#define OKLMS3_TO_X65_C2 make_float3(0.2813910502f,-0.0717110667f,1.5869240244f)

// ---- OKLab ----
#define O_C0 make_float3(0.2104542553f,1.9779984951f,0.0259040371f)
#define O_C1 make_float3(0.793617785f,-2.428592205f,0.7827717662f)
#define O_C2 make_float3(-0.0040720468f,0.4505937099f,-0.808675766f)
#define P_C0 make_float3(1.0f,1.0f,1.0f)
#define P_C1 make_float3(0.3963377774f,-0.1055613458f,-0.0894841775f)
#define P_C2 make_float3(0.2158037573f,-0.0638541728f,-1.291485548f)
// AP1 wrapper matrices used only by optional ACES 1.3 RGC.
#define X65_TO_AP1_C0 make_float3(1.645137477880f,-0.663190970565f,0.011827536679f)
#define X65_TO_AP1_C1 make_float3(-0.305728269983f,1.605239925856f,-0.011607564142f)
#define X65_TO_AP1_C2 make_float3(-0.236812415835f,0.023041811312f,0.918561032294f)
#define AP1_TO_X65_C0 make_float3(0.657631916906f,0.271767176760f,-0.005033538330f)
#define AP1_TO_X65_C1 make_float3(0.126453267991f,0.675103815523f,0.006902836343f)
#define AP1_TO_X65_C2 make_float3(0.166370741628f,0.053129008203f,1.087188452940f)

// ---- LogC3 EI800 + WB constants ----
#define LOGC3_CUT 0.010591f
#define LOGC3_A 5.555556f
#define LOGC3_B 0.052272f
#define LOGC3_C 0.24719f
#define LOGC3_D 0.385537f
#define LOGC3_E 5.367655f
#define LOGC3_F 0.092809f
#define WB_K0 6504.0f
#define WB_KMIN 2500.0f
#define WB_KMAX 20000.0f
#define WB_TINT_MAX_DUV 0.006f
#define WB_UV_K0_U 0.2003926352f
#define WB_UV_K0_V 0.3103420727f
#define WB_UV_D65_U 0.1978300066f
#define WB_UV_D65_V 0.3122133300f
#define LN2 0.6931471805599453094f

// ---- INPUT ----
DEFINE_UI_PARAMS(input_gamut_heal, Input / Fix, DCTLUI_COMBO_BOX, 0, {heal_off,heal_aces_rgc},{Off,ACES 1.3 RGC})

// ---- WB ----
DEFINE_UI_PARAMS(temp, WB / Temp K, DCTLUI_SLIDER_FLOAT, 6504.0, 2500.0, 20000.0, 25.0)
DEFINE_UI_PARAMS(tint, WB / Tint, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 0.1)

// ---- NEGATIVE DEVELOPMENT ----
// Keystone's negative response is fixed technical plumbing; only live printer lights are exposed.
DEFINE_UI_PARAMS(fns_printer_r, Neg / R, DCTLUI_SLIDER_FLOAT, 25.0, 0.0, 50.0, 0.1)
DEFINE_UI_PARAMS(fns_printer_g, Neg / G, DCTLUI_SLIDER_FLOAT, 25.0, 0.0, 50.0, 0.1)
DEFINE_UI_PARAMS(fns_printer_b, Neg / B, DCTLUI_SLIDER_FLOAT, 25.0, 0.0, 50.0, 0.1)

// ---- TONE ----
// Exposure is true scene-linear stops. Contrast uses Primera rolling contrast in LogC3.
DEFINE_UI_PARAMS(p_exposure, Tone / Exp, DCTLUI_SLIDER_FLOAT, 0.0, -6.0, 6.0, 0.01)
DEFINE_UI_PARAMS(p_bp, Tone / Black Pt, DCTLUI_SLIDER_FLOAT, 0.0, -0.05, 0.05, 0.0001)
DEFINE_UI_PARAMS(p_contrast, Tone / Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 2.0, 0.001)
DEFINE_UI_PARAMS(p_shadows, Tone / Shadows, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_highlights, Tone / Highlights, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_high_soft, Tone / Roll, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 2.0, 0.01)

// ---- COLOR ----
DEFINE_UI_PARAMS(pos_saturation, Color / Pos Sat, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.001)
DEFINE_UI_PARAMS(oklab_pos_saturation, Color / Oklab Pos, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.001)

// ---- OUTPUT ----
DEFINE_UI_PARAMS(white_gamut_clean, Out / White, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(black_gamut_clean, Out / Black, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)

// ---- Helpers ----
__DEVICE__ float clampf(float v, float lo, float hi) { return _fmaxf(lo, _fminf(hi, v)); }
__DEVICE__ float3 mmul(float3 c0,float3 c1,float3 c2,float3 v){return make_float3(c0.x*v.x+c1.x*v.y+c2.x*v.z,c0.y*v.x+c1.y*v.y+c2.y*v.z,c0.z*v.x+c1.z*v.y+c2.z*v.z);}
__DEVICE__ float cbrt_s(float x){return(x<0.0f?-1.0f:1.0f)*_powf(_fabs(x),1.0f/3.0f);}
__DEVICE__ int finitef(float x){return (x==x&&_fabs(x)<3.402823e38f)?1:0;}
// ---- Fixed Studio gamut: ARRI Wide Gamut 3 <-> XYZ D65 ----
__DEVICE__ float3 awg3_to_xyz(float3 v){return mmul(R2_C0,R2_C1,R2_C2,v);}
__DEVICE__ float3 xyz_to_awg3(float3 v){return mmul(G2_C0,G2_C1,G2_C2,v);}

// ---- Fixed ARRI LogC3 EI800 ----
__DEVICE__ float logc3_decode_ei800_scalar(float t){
  float cv=LOGC3_E*LOGC3_CUT+LOGC3_F;
  return t>cv?(_powf(10.0f,(t-LOGC3_D)/LOGC3_C)-LOGC3_B)/LOGC3_A:(t-LOGC3_F)/LOGC3_E;
}
__DEVICE__ float logc3_encode_ei800_scalar(float x){
  return x>LOGC3_CUT?LOGC3_C*_log10f(LOGC3_A*x+LOGC3_B)+LOGC3_D:LOGC3_E*x+LOGC3_F;
}
__DEVICE__ float3 logc3_decode_ei800(float3 v){
  return make_float3(logc3_decode_ei800_scalar(v.x),logc3_decode_ei800_scalar(v.y),logc3_decode_ei800_scalar(v.z));
}
__DEVICE__ float3 logc3_encode_ei800(float3 v){
  return make_float3(logc3_encode_ei800_scalar(v.x),logc3_encode_ei800_scalar(v.y),logc3_encode_ei800_scalar(v.z));
}

__DEVICE__ float smootherstep(float e0,float e1,float x){float span=e1-e0;if(span<=1e-12f)return x>=e1?1.0f:0.0f;x=clampf((x-e0)/span,0.0f,1.0f);return x*x*x*(x*(x*6.0f-15.0f)+10.0f);}

// ---- OKLab ----
__DEVICE__ float3 xyz_to_oklab(float3 xyz){float3 lms=mmul(X65_TO_OKLMS_C0,X65_TO_OKLMS_C1,X65_TO_OKLMS_C2,xyz);lms=make_float3(cbrt_s(lms.x),cbrt_s(lms.y),cbrt_s(lms.z));return mmul(O_C0,O_C1,O_C2,lms);}
__DEVICE__ float3 oklab_to_xyz(float3 lab){float3 lms=mmul(P_C0,P_C1,P_C2,lab);lms=make_float3(lms.x*lms.x*lms.x,lms.y*lms.y*lms.y,lms.z*lms.z*lms.z);return mmul(OKLMS3_TO_X65_C0,OKLMS3_TO_X65_C1,OKLMS3_TO_X65_C2,lms);}
__DEVICE__ float3 oklab_to_xyz_preserve_y_safe(float3 lab,float targetY){
  float3 out=oklab_to_xyz(lab);
  if(targetY<=1.0e-20f)return out;
  if(out.y<=1.0e-10f){
    float lo=0.0f,hi=1.0f;
    for(int i=0;i<20;i++){
      float mid=(lo+hi)*0.5f;
      float3 test=make_float3(lab.x,lab.y*mid,lab.z*mid);
      float y=oklab_to_xyz(test).y;
      if(y>targetY*1.0e-8f)lo=mid;else hi=mid;
    }
    lab.y*=lo;lab.z*=lo;out=oklab_to_xyz(lab);
  }
  if(out.y<=1.0e-20f)return make_float3(WHITE_D65.x*targetY,targetY,WHITE_D65.z*targetY);
  float k=targetY/out.y;
  return out*make_float3(k,k,k);
}

// ---- Keystone v1.7 Studio Production Candidate white balance ----
// Exact v1.7 Kelvin/Tint source-white math and Bradford CAT implementation.
// UI:
//   WB / Temp K : 2500K..20000K, D65 default 6504K
//   WB / Tint   : -100..100
//
// This replaces the later Hue/Amt/Warm/Tint wheel implementation.

__DEVICE__ float2 cct_to_xy(float k){
  float k2=k*k,k3=k2*k;
  float x=k<=4000.0f?-0.2661239e9f/k3-0.2343580e6f/k2+0.8776956e3f/k+0.179910f:-3.0258469e9f/k3+2.1070379e6f/k2+0.2226347e3f/k+0.240390f;
  float y=k<=4000.0f?-1.1063814f*x*x*x-1.34811020f*x*x+2.18555832f*x-0.20219683f:3.0817580f*x*x*x-5.8733867f*x*x+3.75112997f*x-0.37001483f;
  return make_float2(x,y);
}

__DEVICE__ float2 xy_to_uv(float2 xy){
  float den=-2.0f*xy.x+12.0f*xy.y+3.0f;
  if(_fabs(den)<1e-8f)return make_float2(WB_UV_D65_U,WB_UV_D65_V);
  return make_float2(4.0f*xy.x/den,6.0f*xy.y/den);
}

__DEVICE__ float2 uv_to_xy(float2 uv){
  float den=2.0f*uv.x-8.0f*uv.y+4.0f;
  if(_fabs(den)<1e-8f)return make_float2(0.3127f,0.3290f);
  return make_float2(3.0f*uv.x/den,2.0f*uv.y/den);
}

__DEVICE__ float wb_kelvin(float temp_value){
  return clampf(temp_value,WB_KMIN,WB_KMAX);
}

__DEVICE__ float3 wb_source_white_xyz(float temp_value,float tint_value){
  if(_fabs(temp_value-WB_K0)<=1e-4f&&_fabs(tint_value)<=1e-7f)return WHITE_D65;
  float k=wb_kelvin(temp_value);
  float2 uv_k=xy_to_uv(cct_to_xy(k));
  float2 uv_k0=make_float2(WB_UV_K0_U,WB_UV_K0_V);
  float2 uv_d65=make_float2(WB_UV_D65_U,WB_UV_D65_V);
  float2 uv_temp=make_float2(uv_d65.x+(uv_k.x-uv_k0.x),uv_d65.y+(uv_k.y-uv_k0.y));
  float2 uv_lo=xy_to_uv(cct_to_xy(k-10.0f));
  float2 uv_hi=xy_to_uv(cct_to_xy(k+10.0f));
  float tx=uv_hi.x-uv_lo.x,ty=uv_hi.y-uv_lo.y;
  float len=_sqrtf(tx*tx+ty*ty);
  float nx=0.0f,ny=0.0f;
  if(len>1e-12f){float inv=1.0f/len;nx=ty*inv;ny=-tx*inv;} // sign chosen so +Tint is magenta correction
  float duv=clampf(tint_value/100.0f,-1.0f,1.0f)*WB_TINT_MAX_DUV;
  float2 xy=uv_to_xy(make_float2(uv_temp.x+nx*duv,uv_temp.y+ny*duv));
  if(xy.y<=1e-6f||xy.x!=xy.x||xy.y!=xy.y)return WHITE_D65;
  return make_float3(xy.x/xy.y,1.0f,(1.0f-xy.x-xy.y)/xy.y);
}

__DEVICE__ float3 bradford_cone(float3 xyz){return mmul(BRADFORD_C0,BRADFORD_C1,BRADFORD_C2,xyz);}

__DEVICE__ float3 bradford_from_cone(float3 lms){return mmul(BRADFORD_INV_C0,BRADFORD_INV_C1,BRADFORD_INV_C2,lms);}

__DEVICE__ float wb_cat_ratio(float dst,float src){
  if(_fabs(src)<=1.0e-8f)return 1.0f;
  return clampf(dst/src,0.10f,10.0f);
}

__DEVICE__ float3 apply_bradford_wb_xyz(float3 xyz,float temp_value,float tint_value){
  if(_fabs(temp_value-WB_K0)<=1.0e-4f&&_fabs(tint_value)<=1.0e-7f)return xyz;

  float3 source_white=wb_source_white_xyz(temp_value,tint_value);
  float3 src_lms=bradford_cone(source_white);
  float3 dst_lms=bradford_cone(WHITE_D65);
  float3 scale=make_float3(
    wb_cat_ratio(dst_lms.x,src_lms.x),
    wb_cat_ratio(dst_lms.y,src_lms.y),
    wb_cat_ratio(dst_lms.z,src_lms.z));

  float3 cone=bradford_cone(xyz);
  float3 adapted=bradford_from_cone(make_float3(cone.x*scale.x,cone.y*scale.y,cone.z*scale.z));

  // Exposure-neutral normalization: a D65 neutral can change chromaticity under the
  // creative WB move, but its Y remains unchanged.
  float3 d65_cone=bradford_cone(WHITE_D65);
  float3 d65_test=bradford_from_cone(make_float3(d65_cone.x*scale.x,d65_cone.y*scale.y,d65_cone.z*scale.z));
  if(d65_test.y>1.0e-8f){
    float k=1.0f/d65_test.y;
    adapted=adapted*make_float3(k,k,k);
  }
  return adapted;
}

// ---- Internal Film Negative Space working-space helpers ----
// Public behavior matched at the signal-model level:
//   scene-linear pivot remap, independent power above/below middle gray,
//   optional smooth transition around the pivot, printer-light density offsets,
//   and an exact inverse around Keystone's creative block.
// This is Keystone's own implementation; it does not copy the external DCTL source.
#define KEYSTONE_FNS_MID_IN 0.18f
#define KEYSTONE_FNS_MID_OUT 0.42f
#define KEYSTONE_FNS_BELOW 0.85f
#define KEYSTONE_FNS_ABOVE 0.75f
#define KEYSTONE_FNS_BLEND 0.30f

__DEVICE__ float fns_printer_gain(float point){
  // One printer point represents 0.025 log10 exposure-density units. Neutral is 25.
  float density=(point-25.0f)*0.025f;
  return _powf(10.0f,density);
}
__DEVICE__ float fns_smooth_integral(float q){return q*q*q-0.5f*q*q*q*q;}
__DEVICE__ float fns_log_response(float stop,float below,float above,float blend){
  if(blend<=1.0e-7f)return stop<0.0f?below*stop:above*stop;
  float d=above-below;
  float F0=fns_smooth_integral(0.5f);
  if(stop<=-blend){
    float q=0.0f;
    float vb=below*(-blend)+d*(2.0f*blend)*(fns_smooth_integral(q)-F0);
    return vb+below*(stop+blend);
  }
  if(stop>=blend){
    float q=1.0f;
    float vb=below*blend+d*(2.0f*blend)*(fns_smooth_integral(q)-F0);
    return vb+above*(stop-blend);
  }
  float q=(stop+blend)/(2.0f*blend);
  return below*stop+d*(2.0f*blend)*(fns_smooth_integral(q)-F0);
}
__DEVICE__ float fns_forward_characteristic(float x,float mid_in,float mid_out,float below,float above,float blend){
  float scale=mid_out/_fmaxf(mid_in,1.0e-8f);
  if(x<=0.0f)return x*scale;
  float ratio=x/_fmaxf(mid_in,1.0e-8f);
  float stop=_log2f(_fmaxf(ratio,1.0e-20f));
  float out_stop=fns_log_response(stop,below,above,blend);
  out_stop=clampf(out_stop,-120.0f,120.0f);
  return mid_out*_powf(2.0f,out_stop);
}
__DEVICE__ float fns_inverse_characteristic(float y,float mid_in,float mid_out,float below,float above,float blend){
  float inv_scale=mid_in/_fmaxf(mid_out,1.0e-8f);
  if(y<=0.0f)return y*inv_scale;

  float out_stop=_log2f(_fmaxf(y/_fmaxf(mid_out,1.0e-8f),1.0e-30f));

  if(blend<=1.0e-7f){
    float p=out_stop<0.0f?_fmaxf(below,1.0e-6f):_fmaxf(above,1.0e-6f);
    float stop=clampf(out_stop/p,-120.0f,120.0f);
    return mid_in*_powf(2.0f,stop);
  }

  float b=_fmaxf(blend,1.0e-6f);
  float d=above-below;
  float F0=fns_smooth_integral(0.5f);
  float neg_edge=below*(-b)+d*(2.0f*b)*(fns_smooth_integral(0.0f)-F0);
  float pos_edge=below*( b)+d*(2.0f*b)*(fns_smooth_integral(1.0f)-F0);

  float stop;
  if(out_stop<=neg_edge){
    stop=-b+(out_stop-neg_edge)/_fmaxf(below,1.0e-6f);
  }else if(out_stop>=pos_edge){
    stop=b+(out_stop-pos_edge)/_fmaxf(above,1.0e-6f);
  }else{
    float lo=-b,hi=b;
    for(int i=0;i<24;i++){
      float m=(lo+hi)*0.5f;
      float f=fns_log_response(m,below,above,b);
      if(f<out_stop)lo=m;else hi=m;
    }
    stop=(lo+hi)*0.5f;
  }

  stop=clampf(stop,-120.0f,120.0f);
  return mid_in*_powf(2.0f,stop);
}
__DEVICE__ float3 fns_forward_rgb(float3 rgb,float mid_in,float mid_out,float below,float above,float blend){
  return make_float3(
    fns_forward_characteristic(rgb.x,mid_in,mid_out,below,above,blend),
    fns_forward_characteristic(rgb.y,mid_in,mid_out,below,above,blend),
    fns_forward_characteristic(rgb.z,mid_in,mid_out,below,above,blend));
}
__DEVICE__ float3 fns_apply_printer_lights(float3 rgb,float pr,float pg,float pb){
  float3 gains=make_float3(fns_printer_gain(pr),fns_printer_gain(pg),fns_printer_gain(pb));
  return rgb*gains;
}
__DEVICE__ float3 fns_inverse_rgb(float3 rgb,float mid_in,float mid_out,float below,float above,float blend){
  return make_float3(
    fns_inverse_characteristic(rgb.x,mid_in,mid_out,below,above,blend),
    fns_inverse_characteristic(rgb.y,mid_in,mid_out,below,above,blend),
    fns_inverse_characteristic(rgb.z,mid_in,mid_out,below,above,blend));
}

// Catastrophic-only scene-domain ceiling. Values within +/-1e8 are untouched;
// beyond that, RGB is uniformly scaled to preserve hue and channel ratios.
__DEVICE__ float3 technical_scene_ceiling_guard(float3 rgb){
  float m=_fmaxf(_fabs(rgb.x),_fmaxf(_fabs(rgb.y),_fabs(rgb.z)));
  if(m<=1.0e8f)return rgb;
  float k=1.0e8f/m;
  return rgb*make_float3(k,k,k);
}

// ---- Primera Black Point ----
// Exact Primera v0.6.0 soft-black-point primitive and call semantics.
// Slider:
//   Black Point: -0.05 .. +0.05, step 0.0001
//
// Primera runs this in linear RGB immediately after Exposure.
// Keystone is fixed to AWG3, so the operator is applied independently to
// scene-linear AWG3 R/G/B before Film Negative Space / Printer Lights.

__DEVICE__ float soft_black_point(float x,float bp,float knee){
  if(x<=0.0f)return x;
  float corrected=x-bp;
  if(corrected>=knee)return corrected;
  return knee*_expf(corrected/knee-1.0f);
}

__DEVICE__ float3 apply_primera_black_point_xyz(float3 xyz,float p_bp){
  if(_fabs(p_bp)<=1.0e-8f)return xyz;

  float3 rgb=xyz_to_awg3(xyz);
  float knee=0.005f;
  float bp=-p_bp;

  rgb=make_float3(
    soft_black_point(rgb.x,bp,knee),
    soft_black_point(rgb.y,bp,knee),
    soft_black_point(rgb.z,bp,knee));

  return awg3_to_xyz(rgb);
}

// ============================================================================
// Primera rolling contrast - exact contrast math at Primera default Pivot = 0
// ============================================================================
//
// Primera applies contrast independently to encoded RGB channels. Keystone is
// fixed to AWG3 / LogC3 EI800, so this is equivalent to Primera with:
//   Transfer Function = ARRI LogC3
//   Pivot = 0.0
//
// The per-channel encoded-domain operation is intentionally preserved. This is
// why the contrast adds colorfulness / saturation and separation as contrast rises.
//
// Exact Primera rolling-contrast equation:
__DEVICE__ float primera_rolling_contrast(float x,float contrast,float pivot){
  if(x<=0.0f)return x;
  if(x>=1.0f)return x;
  if(x<=pivot){
    return _powf(x/pivot,contrast)*pivot;
  }else{
    float inv=1.0f-x;
    float inv_pivot=1.0f-pivot;
    return 1.0f-_powf(inv/inv_pivot,contrast)*inv_pivot;
  }
}

__DEVICE__ float3 apply_primera_contrast_xyz(float3 xyz,float contrast){
  float con=clampf(contrast,0.5f,2.0f);
  if(_fabs(con-1.0f)<=1.0e-8f)return xyz;

  float3 lin=xyz_to_awg3(xyz);
  float3 enc=logc3_encode_ei800(lin);

  // Primera default pivot for LogC3: encode(0.18) + 0.0 pivot offset.
  float pivot=logc3_encode_ei800_scalar(0.18f);
  pivot=_fmaxf(0.01f,_fminf(pivot,0.99f));

  enc=make_float3(
    primera_rolling_contrast(enc.x,con,pivot),
    primera_rolling_contrast(enc.y,con,pivot),
    primera_rolling_contrast(enc.z,con,pivot));

  return awg3_to_xyz(logc3_decode_ei800(enc));
}

// Shadows/Highlights are selected from scene luminance instead of per-channel code values.
// This makes the controls behave like broad HDR/log tonal zones: the qualification is
// color-independent, middle gray stays anchored, and the result cannot create channel hue shifts.
__DEVICE__ float3 keystone_hybrid_zone_masks(float Y){
  float ev=Y>1.0e-10f?_log2f(Y/0.18f):-20.0f;

  // Broad, smooth zones with a clean midtone gap around 18% gray. The fifth-order
  // transitions avoid a visible boundary while keeping the control much more local than
  // the former whole-half encoded response.
  float sw=1.0f-smootherstep(-2.60f,-0.10f,ev);
  float hw=smootherstep(0.10f,2.60f,ev);

  // Do not force chromatic noise/invalid near-black values harder simply because they sit
  // below the shadow threshold. This only fades the final fraction near scene black.
  float black_gate=smootherstep(-7.0f,-5.0f,ev);
  sw*=black_gate;

  return make_float3(clampf(sw,0.0f,1.0f),0.0f,clampf(hw,0.0f,1.0f));
}

__DEVICE__ float3 apply_keystone_hybrid_zones_xyz(float3 xyz,float shadows_value,float highlights_value){
  if(_fabs(shadows_value)<=1.0e-7f&&_fabs(highlights_value)<=1.0e-7f)return xyz;
  float Y=xyz.y;
  if(Y<=0.0f)return xyz;

  float3 masks=keystone_hybrid_zone_masks(Y);
  float stops=shadows_value*masks.x+highlights_value*masks.z;
  float gain=_powf(2.0f,stops);
  return xyz*make_float3(gain,gain,gain);
}
__DEVICE__ float scene_ev_from_y(float Y,float mid){if(Y<=1.0e-10f)return -20.0f;return _log2f(Y/_fmaxf(mid,1.0e-8f));}
__DEVICE__ float3 apply_auto_rolloff_xyz(float3 xyz,float mid,float amount){
  // Monotonic scene-luminance shoulder with a true identity limit at amount=0.
  // The old 0.50+ offset made the first slider increment far too strong.
  float a=clampf(amount,0.0f,2.0f);
  if(a<=1.0e-9f||xyz.y<=1.0e-10f)return xyz;

  float ev=scene_ev_from_y(xyz.y,mid);
  const float knee_ev=2.50f;
  if(ev<=knee_ev)return xyz;

  float d=ev-knee_ev;
  float strength=3.0f*a; // exactly approaches zero with the slider
  if(strength<=1.0e-8f)return xyz;

  // ln(1+s*d)/s, expressed with log2 for conservative DCTL compatibility.
  float out_d=_log2f(1.0f+strength*d)*LN2/strength;
  float out_ev=knee_ev+out_d;
  float Yout=mid*_powf(2.0f,out_ev);
  float k=Yout/xyz.y;
  return xyz*make_float3(k,k,k);
}

// ---- Primera Pos Saturation ----
// This replaces Keystone's former Oklab global saturation slider.
//
// Primera applies positive saturation in encoded RGB:
//   HSV saturation *= 2^amount
//   HSV saturation is capped at 1
//   operation is skipped if any encoded RGB channel is negative
//
// Keystone is fixed to AWG3 / LogC3 EI800, so the current scene result is:
//   XYZ -> AWG3 linear -> LogC3 -> Primera HSV Pos Sat -> LogC3 decode -> XYZ
//
// No luminance-preservation pass is applied. That matches Primera's default
// Pos. Saturation behavior and intentionally allows the saturation operation
// to contribute some density/colorfulness character.


__DEVICE__ float3 ks_rgb_to_hsv(float3 rgb){
  float r=rgb.x,g=rgb.y,b=rgb.z;
  float cmax=_fmaxf(r,_fmaxf(g,b));
  float cmin=_fminf(r,_fminf(g,b));
  float delta=cmax-cmin;

  float h=0.0f;
  if(delta>0.0f){
    if(cmax==r)h=(g-b)/delta;
    else if(cmax==g)h=(b-r)/delta+2.0f;
    else h=(r-g)/delta+4.0f;
    if(h<0.0f)h+=6.0f;
    h/=6.0f;
  }

  float s=(cmax>0.0f)?delta/cmax:0.0f;
  return make_float3(h,s,cmax);
}

__DEVICE__ float3 ks_hsv_to_rgb(float3 hsv){
  float h=hsv.x*6.0f;
  float s=hsv.y;
  float v=hsv.z;

  float c=v*s;
  float x=c*(1.0f-_fabs(h-2.0f*_floorf(h*0.5f)-1.0f));
  float m=v-c;

  float r,g,b;
  if(h<1.0f){r=c;g=x;b=0.0f;}
  else if(h<2.0f){r=x;g=c;b=0.0f;}
  else if(h<3.0f){r=0.0f;g=c;b=x;}
  else if(h<4.0f){r=0.0f;g=x;b=c;}
  else if(h<5.0f){r=x;g=0.0f;b=c;}
  else{r=c;g=0.0f;b=x;}

  return make_float3(r+m,g+m,b+m);
}

__DEVICE__ float3 apply_primera_pos_sat_xyz(float3 xyz,float amount){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-8f)return xyz;

  float3 lin=xyz_to_awg3(xyz);
  float3 enc=logc3_encode_ei800(lin);

  // Match Primera: positive saturation is only applied when all encoded
  // channels are non-negative.
  if(enc.x<0.0f||enc.y<0.0f||enc.z<0.0f)return xyz;

  float3 hsv=ks_rgb_to_hsv(enc);
  hsv.y*=_powf(2.0f,a);
  hsv.y=_fminf(hsv.y,1.0f);

  float3 sat_enc=ks_hsv_to_rgb(hsv);
  float3 sat_lin=logc3_decode_ei800(sat_enc);
  return awg3_to_xyz(sat_lin);
}

// ---- Oklab Positive Saturation ----
// This is a second, separate positive-only saturation control so the Primera
// Pos Sat behavior can be compared directly with a perceptual Oklab version.
//
// Behavior:
//   chroma_out = chroma_in * 2^amount
//
// with:
//   - Oklab L kept fixed
//   - hue angle kept fixed
//   - resulting XYZ rescaled to preserve original scene Y
//
// This remains more hue-stable than HSV Pos Sat, but now adds a modest
// density response so it can keep some of the richer Primera feel.
__DEVICE__ float3 apply_oklab_pos_sat_xyz(float3 xyz,float amount){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-8f)return xyz;
  if(xyz.y<=1.0e-20f)return xyz;

  float3 lab=xyz_to_oklab(xyz);
  float Cin=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  if(Cin<=1.0e-10f)return xyz;

  // Perceptual positive-only chroma increase.
  float scale=_powf(2.0f,a);
  float3 out_lab=make_float3(lab.x,lab.y*scale,lab.z*scale);
  float3 out_xyz=oklab_to_xyz_preserve_y_safe(out_lab,xyz.y);

  // Add a small density response so the Oklab control keeps some of the richer
  // feel of Primera Pos Sat instead of remaining perfectly clean/lightness-only.
  //
  // Behavior:
  // - tied to actual relative chroma gain
  // - fades in only once the source already has meaningful chroma
  // - max density response is intentionally modest
  float Cout=_sqrtf(out_lab.y*out_lab.y+out_lab.z*out_lab.z);
  float rel_gain=0.0f;
  if(Cin>1.0e-8f)rel_gain=clampf(Cout/Cin-1.0f,0.0f,1.0f);

  float chroma_weight=smootherstep(0.015f,0.120f,Cin);
  float density=1.0f-0.16f*a*rel_gain*chroma_weight;
  density=clampf(density,0.84f,1.0f);

  return out_xyz*make_float3(density,density,density);
}


// ---- Internal skin qualifier for Output cleanup protection ----
// User-facing Skin controls and the skin-shaping pass have been removed.
// This qualifier remains internal only so Out / White and Out / Black can
// continue protecting skin automatically.

#define KS_SKIN_CENTER_RN 0.4278f
#define KS_SKIN_CENTER_GN 0.3083f

__DEVICE__ float2 ks_skin_rg(float3 xyz){
  float3 rgb=xyz_to_awg3(xyz);
  float r=_fmaxf(rgb.x,0.0f);
  float g=_fmaxf(rgb.y,0.0f);
  float b=_fmaxf(rgb.z,0.0f);
  float sum=r+g+b;
  if(sum<=1.0e-8f)return make_float2(KS_SKIN_CENTER_RN,KS_SKIN_CENTER_GN);
  return make_float2(r/sum,g/sum);
}

__DEVICE__ float ks_skin_mask_rg(float2 rg,float3 xyz,float range_ctrl){
  float rn=rg.x;
  float gn=rg.y;

  float range=clampf(range_ctrl,0.25f,2.0f);
  float broad=range-1.0f;

  float dr=rn-KS_SKIN_CENTER_RN;
  float dg=gn-KS_SKIN_CENTER_GN;

  // Primera-style center around normalized skin chromaticity.
  float warm=dr-0.51372f*(dg/(-0.85796f));
  float tint=dg/(-0.85796f);

  float warm_half=0.018f+0.020f*range;
  float tint_half=0.020f+0.022f*range;
  float q=(warm*warm)/(warm_half*warm_half)+(tint*tint)/(tint_half*tint_half);
  float rg_gate=1.0f-smootherstep(1.0f,2.10f+0.40f*range,q);

  float bn=1.0f-rn-gn;
  float rb=rn-bn;
  float rb_gate=
    smootherstep(0.020f,0.070f,rb)*
    (1.0f-smootherstep(0.33f+0.03f*broad,0.43f+0.04f*broad,rb));

  float g_gate=
    smootherstep(0.22f-0.02f*broad,0.27f-0.01f*broad,gn)*
    (1.0f-smootherstep(0.36f+0.02f*broad,0.43f+0.03f*broad,gn));

  float rlead_gate=smootherstep(-0.005f,0.025f,rn-gn);

  float3 lab=xyz_to_oklab(xyz);
  float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  float Labs=_fmaxf(_fabs(lab.x),1.0e-6f);
  float relC=C/Labs;

  float chroma_gate=
    smootherstep(0.025f,0.060f,relC)*
    (1.0f-smootherstep(0.34f,0.58f,relC));

  float ev=_log2f(_fmaxf(xyz.y,1.0e-10f)/0.18f);
  float luma_gate=
    smootherstep(-5.0f,-2.1f,ev)*
    (1.0f-smootherstep(3.0f,5.5f,ev));

  return clampf(rg_gate*rb_gate*g_gate*rlead_gate*chroma_gate*luma_gate,0.0f,1.0f);
}

// Output cleanup should not strip useful color out of skin. This helper reuses
// Keystone's skin-qualification engine and attenuates cleanup on confident skin.
// Protection is automatic and does not require another UI control.
//
// A slightly broadened minimum range is used so protection still works even if
// the creative Skin section is set very tight.
__DEVICE__ float output_cleanup_skin_allow(float3 xyz){
  float protect_range=1.0f;
  float2 rg=ks_skin_rg(xyz);
  float skin=ks_skin_mask_rg(rg,xyz,protect_range);

  // Start easing off cleanup on weak skin candidates, then protect strongly on
  // confident skin. Keep a small residual amount available so near-neutral,
  // skin-adjacent pixels can still be cleaned if needed.
  float protect=smootherstep(0.10f,0.55f,skin);
  return 1.0f-0.85f*protect;
}


// White cleanup is intentionally NOT a look transform. It only reduces chroma
// in bright, already-near-neutral colors while preserving scene Y. This is a
// luminance-preserving white-clean operation: no palette matrix, hue rotation,
// Technicolor crosstalk, or global saturation change is present. Saturated
// highlights are protected by the relative-chroma gate.
__DEVICE__ float3 clean_neutral_highlights_xyz(float3 xyz,float amount){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-7f||xyz.y<=1.0e-20f)return xyz;

  float3 lab=xyz_to_oklab(xyz);
  float L=lab.x;
  float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  if(C<=1.0e-20f)return xyz;

  // Stronger real-world white selector. Begin engaging slightly below middle-gray
  // and reach full tonal eligibility by +1 EV. This lets practical white objects
  // become fully neutral instead of being limited by a half-strength brightness mask.
  float ev=_log2f(_fmaxf(xyz.y,1.0e-10f)/0.18f);
  float white_gate=smootherstep(-0.50f,1.00f,ev);

  // Full cleanup is allowed for mildly contaminated near-whites through relC .08.
  // More colorful highlights roll off smoothly, with strong color protected by .30.
  float relC=C/_fmaxf(_fabs(L),1.0e-6f);
  float neutral_gate=1.0f-smootherstep(0.080f,0.300f,relC);

  // Smoothstep slider response with exact 0, 0.5, and 1 reference points.
  float a_eff=a*a*(3.0f-2.0f*a);
  float skin_allow=output_cleanup_skin_allow(xyz);
  float clean=clampf(a_eff*white_gate*neutral_gate*skin_allow,0.0f,1.0f);
  if(clean<=1.0e-7f)return xyz;
  lab.y*=1.0f-clean;
  lab.z*=1.0f-clean;
  return oklab_to_xyz_preserve_y_safe(lab,xyz.y);
}

// Black cleanup mirrors the white-clean idea at the opposite end of the scene
// range. It only reduces chroma in deep, already-near-neutral shadows while
// preserving scene Y. The L floor in the chroma ratio is intentional: without it,
// tiny RGB contamination near black can look artificially "high saturation" and
// prevent the selector from engaging.
__DEVICE__ float3 clean_neutral_shadows_xyz(float3 xyz,float amount){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-7f||xyz.y<=1.0e-20f)return xyz;

  float3 lab=xyz_to_oklab(xyz);
  float L=lab.x;
  float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  if(C<=1.0e-20f)return xyz;

  // Stronger black selector. Deep shadows are fully eligible by -2 EV and the
  // effect fades smoothly out through middle gray instead of stopping at -1 EV.
  float ev=_log2f(_fmaxf(xyz.y,1.0e-10f)/0.18f);
  float black_gate=1.0f-smootherstep(-2.0f,0.0f,ev);

  // Full cleanup is allowed for mildly contaminated near-blacks through relC .06.
  // More colorful shadows are increasingly protected, reaching full protection by .30.
  float relC=C/_fmaxf(_fabs(L),0.12f);
  float neutral_gate=1.0f-smootherstep(0.060f,0.300f,relC);

  float a_eff=a*a*(3.0f-2.0f*a);
  float skin_allow=output_cleanup_skin_allow(xyz);
  float clean=clampf(a_eff*black_gate*neutral_gate*skin_allow,0.0f,1.0f);
  if(clean<=1.0e-7f)return xyz;
  lab.y*=1.0f-clean;
  lab.z*=1.0f-clean;
  return oklab_to_xyz_preserve_y_safe(lab,xyz.y);
}

// ---- Technical encode-domain guard ----
// This is NOT creative gamut mapping. It only prevents pathological imaginary RGB
// ratios produced by extreme combinations from exploding vendor log encoders.
// Normal extended/negative values are preserved. For positive scene Y, channel
// excursions are bounded only when they become catastrophic for downstream encoders; ordinary negative values remain extended.
// Final transfer-aware safety gate. A scene-linear value that looks merely extended can
// encode to a catastrophic negative number in some log curves. For positive scene Y,
// reduce only chroma (toward the equal-RGB neutral at the same Y) when final encoded RGB
// would fall below -1.0. Ordinary extended negatives remain untouched.
__DEVICE__ float3 technical_encoded_negative_guard(float3 rgb,float Y){
  const float code_floor=-1.0f;
  float3 enc=logc3_encode_ei800(rgb);
  float mn=_fminf(enc.x,_fminf(enc.y,enc.z));
  if(mn>=code_floor)return rgb;

  if(Y>0.0f){
    float3 neutral=make_float3(Y,Y,Y);
    float3 delta=rgb-neutral;
    float3 neutral_enc=logc3_encode_ei800(neutral);
    float neutral_min=_fminf(neutral_enc.x,_fminf(neutral_enc.y,neutral_enc.z));
    if(neutral_min>=code_floor){
      float lo=0.0f,hi=1.0f;
      for(int i=0;i<16;i++){
        float mid=(lo+hi)*0.5f;
        float3 candidate=neutral+delta*make_float3(mid,mid,mid);
        float3 candidate_enc=logc3_encode_ei800(candidate);
        float candidate_min=_fminf(candidate_enc.x,_fminf(candidate_enc.y,candidate_enc.z));
        if(candidate_min>=code_floor)lo=mid;else hi=mid;
      }
      return neutral+delta*make_float3(lo,lo,lo);
    }
  }

  float lo=0.0f,hi=1.0f;
  for(int i=0;i<16;i++){
    float mid=(lo+hi)*0.5f;
    float3 candidate=rgb*make_float3(mid,mid,mid);
    float3 candidate_enc=logc3_encode_ei800(candidate);
    float candidate_min=_fminf(candidate_enc.x,_fminf(candidate_enc.y,candidate_enc.z));
    if(candidate_min>=code_floor)lo=mid;else hi=mid;
  }
  return rgb*make_float3(lo,lo,lo);
}

// ---- Input Gamut Heal: ACES 1.3 RGC core in AP1 wrapper ----
// Optional technical input repair only; AP1 is a local reference-operator domain, not Keystone's working space.
__DEVICE__ float rgc_comp_dist(float dn,float t,float ss){if(dn<t)return dn;float x=(dn-t)/ss;float dp=_powf(_fmaxf(x,0.0f),1.2f);return t+(dn-t)/_powf(1.0f+dp,1.0f/1.2f);}
__DEVICE__ float3 rgc_core_ap1(float3 rgb){float A=_fmaxf(rgb.x,_fmaxf(rgb.y,rgb.z));float aa=_fabs(A);if(aa<=1e-20f)return rgb;float dnR=(A-rgb.x)/aa,dnG=(A-rgb.y)/aa,dnB=(A-rgb.z)/aa;float dcR=rgc_comp_dist(dnR,0.815f,0.327301877468f);float dcG=rgc_comp_dist(dnG,0.803f,0.285938028927f);float dcB=rgc_comp_dist(dnB,0.880f,0.146821457838f);return make_float3(A-dcR*aa,A-dcG*aa,A-dcB*aa);}
__DEVICE__ float3 input_gamut_heal_xyz(float3 xyz){float3 ap1=mmul(X65_TO_AP1_C0,X65_TO_AP1_C1,X65_TO_AP1_C2,xyz);ap1=rgc_core_ap1(ap1);return mmul(AP1_TO_X65_C0,AP1_TO_X65_C1,AP1_TO_X65_C2,ap1);}

__DEVICE__ float3 transform(int p_Width,int p_Height,int p_X,int p_Y,float p_R,float p_G,float p_B){
  float c_temp=clampf(temp,WB_KMIN,WB_KMAX);
  float c_tint=clampf(tint,-100.0f,100.0f);
  float c_fns_pr=clampf(fns_printer_r,0.0f,50.0f);
  float c_fns_pg=clampf(fns_printer_g,0.0f,50.0f);
  float c_fns_pb=clampf(fns_printer_b,0.0f,50.0f);
  float c_p_exposure=clampf(p_exposure,-6.0f,6.0f);
  float c_p_bp=clampf(p_bp,-0.05f,0.05f);
  float c_p_contrast=clampf(p_contrast,0.5f,2.0f);
  float c_p_shadows=clampf(p_shadows,-1.0f,1.0f);
  float c_p_highlights=clampf(p_highlights,-1.0f,1.0f);
  float c_p_high_soft=clampf(p_high_soft,0.0f,2.0f);
  float c_pos_saturation=clampf(pos_saturation,0.0f,1.0f);
  float c_oklab_pos_saturation=clampf(oklab_pos_saturation,0.0f,1.0f);
  float c_whiteclean=clampf(white_gamut_clean,0.0f,1.0f);
  float c_blackclean=clampf(black_gamut_clean,0.0f,1.0f);
  int raw_heal=(int)(input_gamut_heal+0.5f);
  int c_heal=raw_heal==heal_aces_rgc?1:0;

  float3 input=make_float3(p_R,p_G,p_B);

  bool base_neutral=
    c_heal==0&&
    _fabs(c_temp-WB_K0)<=1e-4f&&_fabs(c_tint)<=1e-7f&&
    _fabs(c_p_exposure)<=1e-7f&&_fabs(c_p_bp)<=1e-7f&&
    _fabs(c_p_contrast-1.0f)<=1e-7f&&
    _fabs(c_p_shadows)<=1e-7f&&_fabs(c_p_highlights)<=1e-7f&&
    c_p_high_soft<=1e-7f&&c_pos_saturation<=1e-7f&&c_oklab_pos_saturation<=1e-7f&&
    _fabs(c_fns_pr-25.0f)<=1e-7f&&_fabs(c_fns_pg-25.0f)<=1e-7f&&_fabs(c_fns_pb-25.0f)<=1e-7f&&
    c_whiteclean<=1e-7f&&c_blackclean<=1e-7f;
  if(base_neutral)return input;

  float3 lin=logc3_decode_ei800(input);

  if(c_heal==1){
    float3 repair_xyz=awg3_to_xyz(lin);
    repair_xyz=input_gamut_heal_xyz(repair_xyz);
    lin=xyz_to_awg3(repair_xyz);
  }

  float3 xyz=awg3_to_xyz(lin);

  if(_fabs(c_temp-WB_K0)>1e-4f||_fabs(c_tint)>1e-7f)
    xyz=apply_bradford_wb_xyz(xyz,c_temp,c_tint);

  // True scene-linear global exposure.
  if(_fabs(c_p_exposure)>1.0e-7f){
    float k=_powf(2.0f,c_p_exposure);
    xyz*=make_float3(k,k,k);
  }

  // Exact Primera Black Point: linear RGB, immediately after Exposure.
  if(_fabs(c_p_bp)>1.0e-9f)
    xyz=apply_primera_black_point_xyz(xyz,c_p_bp);

  // Film Negative Space is used only for printer-light density balance.
  bool printer_active=
    _fabs(c_fns_pr-25.0f)>1e-7f||
    _fabs(c_fns_pg-25.0f)>1e-7f||
    _fabs(c_fns_pb-25.0f)>1e-7f;
  if(printer_active){
    float3 neg=xyz_to_awg3(xyz);
    neg=fns_forward_rgb(neg,KEYSTONE_FNS_MID_IN,KEYSTONE_FNS_MID_OUT,KEYSTONE_FNS_BELOW,KEYSTONE_FNS_ABOVE,KEYSTONE_FNS_BLEND);
    neg=fns_apply_printer_lights(neg,c_fns_pr,c_fns_pg,c_fns_pb);
    neg=fns_inverse_rgb(neg,KEYSTONE_FNS_MID_IN,KEYSTONE_FNS_MID_OUT,KEYSTONE_FNS_BELOW,KEYSTONE_FNS_ABOVE,KEYSTONE_FNS_BLEND);
    neg=technical_scene_ceiling_guard(neg);
    xyz=awg3_to_xyz(neg);
  }

  // Exact Primera rolling contrast at default pivot, in AWG3 / LogC3.
  xyz=apply_primera_contrast_xyz(xyz,c_p_contrast);

  xyz=apply_keystone_hybrid_zones_xyz(xyz,c_p_shadows,c_p_highlights);

  if(c_p_high_soft>1.0e-7f)
    xyz=apply_auto_rolloff_xyz(xyz,0.18f,c_p_high_soft);

  if(c_pos_saturation>1.0e-7f)
    xyz=apply_primera_pos_sat_xyz(xyz,c_pos_saturation);

  if(c_oklab_pos_saturation>1.0e-7f)
    xyz=apply_oklab_pos_sat_xyz(xyz,c_oklab_pos_saturation);

  if(c_whiteclean>1e-7f)
    xyz=clean_neutral_highlights_xyz(xyz,c_whiteclean);
  if(c_blackclean>1e-7f)
    xyz=clean_neutral_shadows_xyz(xyz,c_blackclean);

  float3 cam=xyz_to_awg3(xyz);

  // Catastrophic-only guards. Recompute current scene Y after every operation that
  // can rescale RGB so later guards never use stale luminance.
  cam=technical_scene_ceiling_guard(cam);
  float3 current_xyz=awg3_to_xyz(cam);
  float currentY=current_xyz.y;

  cam=technical_encoded_negative_guard(cam,currentY);
  float3 result=logc3_encode_ei800(cam);

  // Coherent failure fallback: never zero one channel independently.
  if(finitef(result.x)&&finitef(result.y)&&finitef(result.z))return result;
  if(finitef(input.x)&&finitef(input.y)&&finitef(input.z))return input;
  return make_float3(0.0f,0.0f,0.0f);
}
