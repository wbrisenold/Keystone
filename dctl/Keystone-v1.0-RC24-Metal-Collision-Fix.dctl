// ---- BALANCE ----
// Native RGB channel trims are deliberately camera-gamut dependent.
// General white balance belongs in Temperature/Tint above; use these for deliberate channel balance.
DEFINE_UI_PARAMS(balance_red, Balance / Red, DCTLUI_SLIDER_FLOAT, 0.0, -0.50, 0.50, 0.01)
DEFINE_UI_PARAMS(balance_green, Balance / Green, DCTLUI_SLIDER_FLOAT, 0.0, -0.50, 0.50, 0.01)
DEFINE_UI_PARAMS(balance_blue, Balance / Blue, DCTLUI_SLIDER_FLOAT, 0.0, -0.50, 0.50, 0.01)

// ---- EXPOSURE / TONE (Primera v0.5.5 math) ----
