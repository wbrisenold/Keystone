// ---- COLOR VOLUME ----
// Technical luma-axis compression. Defaults are neutral.
DEFINE_UI_PARAMS(cv_gamut_compression, Volume / Compress, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(cv_gamut_threshold, Volume / Threshold, DCTLUI_SLIDER_FLOAT, 0.82, 0.50, 0.98, 0.005)
// Highlight Volume progressively reduces purity only where scene exposure is high AND
// color already occupies a meaningful fraction of its hue-dependent native gamut boundary.
DEFINE_UI_PARAMS(cv_highlight_volume, Volume / Highlights, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(cv_highlight_purity, Volume / Purity, DCTLUI_SLIDER_FLOAT, 0.78, 0.30, 1.00, 0.01)
DEFINE_UI_PARAMS(cv_highlight_start, Volume / Start EV, DCTLUI_SLIDER_FLOAT, 1.5, -1.0, 4.0, 0.1)
// Diagnostics are encoded back through the selected native transfer so they remain
// usable in Keystone's normal pre-ODT placement.
DEFINE_UI_PARAMS(cv_view, Volume / View, DCTLUI_COMBO_BOX, 0, {cv_normal,cv_gamut_stress,cv_compression_view,cv_highlight_stress},{Normal,Gamut Stress,Compression Amount,Highlight Volume Stress})

