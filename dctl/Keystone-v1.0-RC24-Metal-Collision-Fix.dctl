// ---- Helpers ----
__DEVICE__ float clampf(float v, float lo, float hi) { return _fmaxf(lo, _fminf(hi, v)); }
__DEVICE__ float3 mmul(float3 c0,float3 c1,float3 c2,float3 v){return make_float3(c0.x*v.x+c1.x*v.y+c2.x*v.z,c0.y*v.x+c1.y*v.y+c2.y*v.z,c0.z*v.x+c1.z*v.y+c2.z*v.z);}
__DEVICE__ float cbrt_s(float x){return(x<0.0f?-1.0f:1.0f)*_powf(_fabs(x),1.0f/3.0f);}
__DEVICE__ float spowf(float x,float p){float y=_powf(_fabs(x),p);return(x<0.0f)?-y:y;}
__DEVICE__ float signed_square(float x){return x>=0.0f?x*x:-x*x;}
__DEVICE__ float finite_or_zero(float x){return(x==x&&_fabs(x)<3.402823e38f)?x:0.0f;}
__DEVICE__ float3 cat16_adapt(float3 xyz,float3 src_white,float3 dst_white){
  float3 lms=mmul(CAT16_C0,CAT16_C1,CAT16_C2,xyz);
  float3 src=mmul(CAT16_C0,CAT16_C1,CAT16_C2,src_white);
  float3 dst=mmul(CAT16_C0,CAT16_C1,CAT16_C2,dst_white);
  lms=make_float3(lms.x*dst.x/src.x,lms.y*dst.y/src.y,lms.z*dst.z/src.z);
  return mmul(CAT16I_C0,CAT16I_C1,CAT16I_C2,lms);
}
__DEVICE__ float3 d60_to_d65(float3 xyz){return cat16_adapt(xyz,WHITE_D60,WHITE_D65);}
__DEVICE__ float3 d65_to_d60(float3 xyz){return cat16_adapt(xyz,WHITE_D65,WHITE_D60);}
__DEVICE__ float2 cct_to_xy(float k){
  float k2=k*k,k3=k2*k;
  float x=k<=4000.0f?-0.2661239e9f/k3-0.2343580e6f/k2+0.8776956e3f/k+0.179910f:-3.0258469e9f/k3+2.1070379e6f/k2+0.2226347e3f/k+0.240390f;
  float y=k<=4000.0f?-1.1063814f*x*x*x-1.34811020f*x*x+2.18555832f*x-0.20219683f:3.0817580f*x*x*x-5.8733867f*x*x+3.75112997f*x-0.37001483f;
  return make_float2(x,y);
}
__DEVICE__ float2 xy_to_uv(float2 xy){
  float den=-2.0f*xy.x+12.0f*xy.y+3.0f;
  if(_fabs(den)<1e-8f)return make_float2(WB_UV_D65_U,WB_UV_D65_V);
  return make_float2(4.0f*xy.x/den,6.0f*xy.y/den);
}
__DEVICE__ float2 uv_to_xy(float2 uv){
  float den=2.0f*uv.x-8.0f*uv.y+4.0f;
  if(_fabs(den)<1e-8f)return make_float2(0.3127f,0.3290f);
  return make_float2(3.0f*uv.x/den,2.0f*uv.y/den);
}
__DEVICE__ float wb_kelvin(float temp_value){
  float u=clampf(temp_value/100.0f,-1.0f,1.0f);
  float lr;
  if(u>=0.0f)lr=WB_LOG_M*u+(WB_LOG_A-WB_LOG_M)*u*u;
  else{float q=-u;lr=-(WB_LOG_M*q+(WB_LOG_B-WB_LOG_M)*q*q);}
  return clampf(WB_K0*_expf(lr),WB_KMIN,WB_KMAX);
}
__DEVICE__ float3 wb_source_white_xyz(float temp_value,float tint_value){
  if(_fabs(temp_value)<=1e-7f&&_fabs(tint_value)<=1e-7f)return WHITE_D65;
  float k=wb_kelvin(temp_value);
  float2 uv_k=xy_to_uv(cct_to_xy(k));
  float2 uv_k0=make_float2(WB_UV_K0_U,WB_UV_K0_V);
  float2 uv_d65=make_float2(WB_UV_D65_U,WB_UV_D65_V);
  float2 uv_temp=make_float2(uv_d65.x+(uv_k.x-uv_k0.x),uv_d65.y+(uv_k.y-uv_k0.y));
  float2 uv_lo=xy_to_uv(cct_to_xy(k-10.0f));
  float2 uv_hi=xy_to_uv(cct_to_xy(k+10.0f));
  float tx=uv_hi.x-uv_lo.x,ty=uv_hi.y-uv_lo.y;
  float len=_sqrtf(tx*tx+ty*ty);
  float nx=0.0f,ny=0.0f;
  if(len>1e-12f){float inv=1.0f/len;nx=ty*inv;ny=-tx*inv;} // sign chosen so +Tint is magenta correction
  float duv=clampf(tint_value/100.0f,-1.0f,1.0f)*WB_TINT_MAX_DUV;
  float2 xy=uv_to_xy(make_float2(uv_temp.x+nx*duv,uv_temp.y+ny*duv));
  if(xy.y<=1e-6f||xy.x!=xy.x||xy.y!=xy.y)return WHITE_D65;
  return make_float3(xy.x/xy.y,1.0f,(1.0f-xy.x-xy.y)/xy.y);
}
// ---- Gamut -> XYZ ----
__DEVICE__ float3 g2x(int g,float3 v){
  if(g==0)return mmul(R0_C0,R0_C1,R0_C2,v);
  if(g==1)return mmul(R1_C0,R1_C1,R1_C2,v);
  if(g==2)return mmul(R2_C0,R2_C1,R2_C2,v);
  if(g==3)return mmul(R3_C0,R3_C1,R3_C2,v);
  if(g==4)return mmul(R4_C0,R4_C1,R4_C2,v);
  if(g==5)return mmul(R5_C0,R5_C1,R5_C2,v);
  if(g==6)return mmul(R6_C0,R6_C1,R6_C2,v);
  if(g==7)return mmul(R7_C0,R7_C1,R7_C2,v);
  if(g==8)return mmul(R8_C0,R8_C1,R8_C2,v);
  if(g==9)return mmul(R9_C0,R9_C1,R9_C2,v);
  if(g==10)return mmul(R10_C0,R10_C1,R10_C2,v);
  if(g==11)return mmul(R11_C0,R11_C1,R11_C2,v);
  if(g==12)return mmul(R12_C0,R12_C1,R12_C2,v);
  return mmul(R0_C0,R0_C1,R0_C2,v);
}
// ---- XYZ -> Gamut (inverse) ----
__DEVICE__ float3 x2g(int g,float3 v){
  if(g==0)return mmul(G0_C0,G0_C1,G0_C2,v);
  if(g==1)return mmul(G1_C0,G1_C1,G1_C2,v);
  if(g==2)return mmul(G2_C0,G2_C1,G2_C2,v);
  if(g==3)return mmul(G3_C0,G3_C1,G3_C2,v);
  if(g==4)return mmul(G4_C0,G4_C1,G4_C2,v);
  if(g==5)return mmul(G5_C0,G5_C1,G5_C2,v);
  if(g==6)return mmul(G6_C0,G6_C1,G6_C2,v);
  if(g==7)return mmul(G7_C0,G7_C1,G7_C2,v);
  if(g==8)return mmul(G8_C0,G8_C1,G8_C2,v);
  if(g==9)return mmul(G9_C0,G9_C1,G9_C2,v);
  if(g==10)return mmul(G10_C0,G10_C1,G10_C2,v);
  if(g==11)return mmul(G11_C0,G11_C1,G11_C2,v);
  if(g==12)return mmul(G12_C0,G12_C1,G12_C2,v);
  return mmul(G0_C0,G0_C1,G0_C2,v);
}

// ---- ARRI LogC3 exposure-value parameters (EI 160..1600) ----
// ARRI's compact exposure-value formula is EI-specific through EI1600.
// EI800 remains the default/interchange behavior. No >EI1600 camera shoulder is fabricated.
__DEVICE__ float logc3_cut_ei(int i){if(i==0)return 0.005561f;if(i==1)return 0.006208f;if(i==2)return 0.006871f;if(i==3)return 0.007622f;if(i==4)return 0.008318f;if(i==5)return 0.009031f;if(i==6)return 0.009840f;if(i==8)return 0.011361f;if(i==9)return 0.012235f;if(i==10)return 0.013047f;return 0.010591f;}
__DEVICE__ float logc3_b_ei(int i){if(i==0)return 0.080216f;if(i==1)return 0.076621f;if(i==2)return 0.072941f;if(i==3)return 0.068768f;if(i==4)return 0.064901f;if(i==5)return 0.060939f;if(i==6)return 0.056443f;if(i==8)return 0.047996f;if(i==9)return 0.043137f;if(i==10)return 0.038625f;return 0.052272f;}
__DEVICE__ float logc3_c_ei(int i){if(i==0)return 0.269036f;if(i==1)return 0.266007f;if(i==2)return 0.262978f;if(i==3)return 0.259627f;if(i==4)return 0.256598f;if(i==5)return 0.253569f;if(i==6)return 0.250219f;if(i==8)return 0.244161f;if(i==9)return 0.240810f;if(i==10)return 0.237781f;return 0.247190f;}
__DEVICE__ float logc3_d_ei(int i){if(i==0)return 0.381991f;if(i==1)return 0.382478f;if(i==2)return 0.382966f;if(i==3)return 0.383508f;if(i==4)return 0.383999f;if(i==5)return 0.384493f;if(i==6)return 0.385040f;if(i==8)return 0.386036f;if(i==9)return 0.386590f;if(i==10)return 0.387093f;return 0.385537f;}
__DEVICE__ float logc3_e_ei(int i){if(i==0)return 5.842037f;if(i==1)return 5.776265f;if(i==2)return 5.710494f;if(i==3)return 5.637732f;if(i==4)return 5.571960f;if(i==5)return 5.506188f;if(i==6)return 5.433426f;if(i==8)return 5.301883f;if(i==9)return 5.229121f;if(i==10)return 5.163350f;return 5.367655f;}
__DEVICE__ float logc3_f_ei(int i){if(i==0)return 0.092778f;if(i==1)return 0.092782f;if(i==2)return 0.092786f;if(i==3)return 0.092791f;if(i==4)return 0.092795f;if(i==5)return 0.092800f;if(i==6)return 0.092805f;if(i==8)return 0.092814f;if(i==9)return 0.092819f;if(i==10)return 0.092824f;return 0.092809f;}
__DEVICE__ float logc3_decode_ei_scalar(float t,int i){float cut=logc3_cut_ei(i),b=logc3_b_ei(i),c=logc3_c_ei(i),d=logc3_d_ei(i),e=logc3_e_ei(i),f=logc3_f_ei(i);float cv=e*cut+f;return t>cv?(_powf(10.0f,(t-d)/c)-b)/5.555556f:(t-f)/e;}
__DEVICE__ float logc3_encode_ei_scalar(float x,int i){float cut=logc3_cut_ei(i),b=logc3_b_ei(i),c=logc3_c_ei(i),d=logc3_d_ei(i),e=logc3_e_ei(i),f=logc3_f_ei(i);return x>cut?c*_log10f(5.555556f*x+b)+d:e*x+f;}
__DEVICE__ float3 tfl3d_ei(float3 v,int i){return make_float3(logc3_decode_ei_scalar(v.x,i),logc3_decode_ei_scalar(v.y,i),logc3_decode_ei_scalar(v.z,i));}
__DEVICE__ float3 tfl3e_ei(float3 v,int i){return make_float3(logc3_encode_ei_scalar(v.x,i),logc3_encode_ei_scalar(v.y,i),logc3_encode_ei_scalar(v.z,i));}

// ---- TFs: decode ----
__DEVICE__ float3 tf709d(float3 v){float3 o;o.x=v.x<=0.081f?v.x/4.5f:_powf((v.x+0.099f)/1.099f,1.0f/0.45f);o.y=v.y<=0.081f?v.y/4.5f:_powf((v.y+0.099f)/1.099f,1.0f/0.45f);o.z=v.z<=0.081f?v.z/4.5f:_powf((v.z+0.099f)/1.099f,1.0f/0.45f);return o;}
__DEVICE__ float3 tfl4d(float3 v){float a=LOGC4_A,b=LOGC4_B,c=LOGC4_C,s2=LOGC4_S2,t=LOGC4_T;float3 o;o.x=v.x>=0.0f?(_powf(2.0f,14.0f*((v.x-c)/b)+6.0f)-64.0f)/a:v.x*s2+t;o.y=v.y>=0.0f?(_powf(2.0f,14.0f*((v.y-c)/b)+6.0f)-64.0f)/a:v.y*s2+t;o.z=v.z>=0.0f?(_powf(2.0f,14.0f*((v.z-c)/b)+6.0f)-64.0f)/a:v.z*s2+t;return o;}
__DEVICE__ float3 tfl3d(float3 v){float cv=LOGC3_E*LOGC3_CUT+LOGC3_F;float3 o;o.x=v.x>cv?(_powf(10.0f,(v.x-LOGC3_D)/LOGC3_C)-LOGC3_B)/LOGC3_A:(v.x-LOGC3_F)/LOGC3_E;o.y=v.y>cv?(_powf(10.0f,(v.y-LOGC3_D)/LOGC3_C)-LOGC3_B)/LOGC3_A:(v.y-LOGC3_F)/LOGC3_E;o.z=v.z>cv?(_powf(10.0f,(v.z-LOGC3_D)/LOGC3_C)-LOGC3_B)/LOGC3_A:(v.z-LOGC3_F)/LOGC3_E;return o;}
__DEVICE__ float3 tfs3d(float3 v){float3 o;o.x=v.x>=171.2102946929f/1023.0f?(_powf(10.0f,(v.x*1023.0f-420.0f)/261.5f))*0.19f-0.01f:(v.x*1023.0f-95.0f)*0.01125f/(171.2102946929f-95.0f);o.y=v.y>=171.2102946929f/1023.0f?(_powf(10.0f,(v.y*1023.0f-420.0f)/261.5f))*0.19f-0.01f:(v.y*1023.0f-95.0f)*0.01125f/(171.2102946929f-95.0f);o.z=v.z>=171.2102946929f/1023.0f?(_powf(10.0f,(v.z*1023.0f-420.0f)/261.5f))*0.19f-0.01f:(v.z*1023.0f-95.0f)*0.01125f/(171.2102946929f-95.0f);return o;}
__DEVICE__ float3 tfvld(float3 v){float cut=0.181f,b=0.00873f,c=0.241514f,d=0.598206f;float3 o;o.x=v.x<cut?(v.x-0.125f)/5.6f:_powf(10.0f,(v.x-d)/c)-b;o.y=v.y<cut?(v.y-0.125f)/5.6f:_powf(10.0f,(v.y-d)/c)-b;o.z=v.z<cut?(v.z-0.125f)/5.6f:_powf(10.0f,(v.z-d)/c)-b;return o;}
__DEVICE__ float3 tflg10d(float3 v){float B=25.0f*(_sqrtf(4093.0f)-3.0f)/9.0f,A=1.0f/_log10f(B*184.32f+1.0f);return make_float3(v.x<0.0f?v.x/(A*B*0.4342944819f):(_powf(10.0f,v.x/A)-1.0f)/B,v.y<0.0f?v.y/(A*B*0.4342944819f):(_powf(10.0f,v.y/A)-1.0f)/B,v.z<0.0f?v.z/(A*B*0.4342944819f):(_powf(10.0f,v.z/A)-1.0f)/B);}
__DEVICE__ float3 tfdwd(float3 v){float A=0.0075f,B=7.0f,C=0.07329248f,LC=0.02740668f,M=10.44426855f;float3 o;o.x=v.x<=LC?v.x/M:_powf(2.0f,(v.x/C)-B)-A;o.y=v.y<=LC?v.y/M:_powf(2.0f,(v.y/C)-B)-A;o.z=v.z<=LC?v.z/M:_powf(2.0f,(v.z/C)-B)-A;return o;}
__DEVICE__ float3 tfc2d(float3 v){float k=0.092864125f,m=0.24136077f,n=87.09937546f;float3 o;o.x=v.x<k?-(_powf(10.0f,(k-v.x)/m)-1.0f)/n:(_powf(10.0f,(v.x-k)/m)-1.0f)/n;o.y=v.y<k?-(_powf(10.0f,(k-v.y)/m)-1.0f)/n:(_powf(10.0f,(v.y-k)/m)-1.0f)/n;o.z=v.z<k?-(_powf(10.0f,(k-v.z)/m)-1.0f)/n:(_powf(10.0f,(v.z-k)/m)-1.0f)/n;return o*0.9f;}
__DEVICE__ float3 tfc3d(float3 v){float3 o;o.x=v.x<0.097465473f?-(_powf(10.0f,(0.12783901f-v.x)/0.36726845f)-1.0f)/14.98325f:(v.x<=0.15277891f?(v.x-0.12512219f)/1.9754798f:(_powf(10.0f,(v.x-0.12240537f)/0.36726845f)-1.0f)/14.98325f);o.y=v.y<0.097465473f?-(_powf(10.0f,(0.12783901f-v.y)/0.36726845f)-1.0f)/14.98325f:(v.y<=0.15277891f?(v.y-0.12512219f)/1.9754798f:(_powf(10.0f,(v.y-0.12240537f)/0.36726845f)-1.0f)/14.98325f);o.z=v.z<0.097465473f?-(_powf(10.0f,(0.12783901f-v.z)/0.36726845f)-1.0f)/14.98325f:(v.z<=0.15277891f?(v.z-0.12512219f)/1.9754798f:(_powf(10.0f,(v.z-0.12240537f)/0.36726845f)-1.0f)/14.98325f);return o*0.9f;}
__DEVICE__ float3 tfdld(float3 v){float3 o;o.x=v.x<=0.14f?(v.x-0.0929f)/6.025f:(_powf(10.0f,3.89616f*v.x-2.27752f)-0.0108f)/0.9892f;o.y=v.y<=0.14f?(v.y-0.0929f)/6.025f:(_powf(10.0f,3.89616f*v.y-2.27752f)-0.0108f)/0.9892f;o.z=v.z<=0.14f?(v.z-0.0929f)/6.025f:(_powf(10.0f,3.89616f*v.z-2.27752f)-0.0108f)/0.9892f;return o;}
__DEVICE__ float3 tfapl(float3 v){float Pt=APPLE_SIGMA*(APPLE_RT-APPLE_R0)*(APPLE_RT-APPLE_R0);float3 o;o.x=v.x>=Pt?_powf(2.0f,(v.x-APPLE_DELTA)/APPLE_GAMMA)-APPLE_BETA:(v.x>=0.0f?_sqrtf(v.x/APPLE_SIGMA)+APPLE_R0:APPLE_R0);o.y=v.y>=Pt?_powf(2.0f,(v.y-APPLE_DELTA)/APPLE_GAMMA)-APPLE_BETA:(v.y>=0.0f?_sqrtf(v.y/APPLE_SIGMA)+APPLE_R0:APPLE_R0);o.z=v.z>=Pt?_powf(2.0f,(v.z-APPLE_DELTA)/APPLE_GAMMA)-APPLE_BETA:(v.z>=0.0f?_sqrtf(v.z/APPLE_SIGMA)+APPLE_R0:APPLE_R0);return o;}
__DEVICE__ float3 tfcctd(float3 v){float A=10.5402377417f,B=0.0729055342f,YB=0.15525114f;float3 o;o.x=v.x<=YB?(v.x-B)/A:_powf(2.0f,v.x*17.52f-9.72f);o.y=v.y<=YB?(v.y-B)/A:_powf(2.0f,v.y*17.52f-9.72f);o.z=v.z<=YB?(v.z-B)/A:_powf(2.0f,v.z*17.52f-9.72f);return o;}
__DEVICE__ float3 tfbmd5d(float3 v){float3 o;o.x=v.x<=BMD5_LOG_CUT?(v.x-BMD5_E)/BMD5_D:_expf((v.x-BMD5_C)/BMD5_A)-BMD5_B;o.y=v.y<=BMD5_LOG_CUT?(v.y-BMD5_E)/BMD5_D:_expf((v.y-BMD5_C)/BMD5_A)-BMD5_B;o.z=v.z<=BMD5_LOG_CUT?(v.z-BMD5_E)/BMD5_D:_expf((v.z-BMD5_C)/BMD5_A)-BMD5_B;return o;}
__DEVICE__ float3 tfflog2d(float3 v){float3 o;o.x=v.x>=FLOG2_CUT2?(_powf(10.0f,(v.x-FLOG2_D)/FLOG2_C)-FLOG2_B)/FLOG2_A:(v.x-FLOG2_F)/FLOG2_E;o.y=v.y>=FLOG2_CUT2?(_powf(10.0f,(v.y-FLOG2_D)/FLOG2_C)-FLOG2_B)/FLOG2_A:(v.y-FLOG2_F)/FLOG2_E;o.z=v.z>=FLOG2_CUT2?(_powf(10.0f,(v.z-FLOG2_D)/FLOG2_C)-FLOG2_B)/FLOG2_A:(v.z-FLOG2_F)/FLOG2_E;return o;}
__DEVICE__ float nlog_decode_scalar(float encoded){float code=encoded*1023.0f;if(code<452.0f){float u=code/650.0f;return u*u*u-0.0075f;}return _expf((code-619.0f)/150.0f);}
__DEVICE__ float3 tfnlogd(float3 v){return make_float3(nlog_decode_scalar(v.x),nlog_decode_scalar(v.y),nlog_decode_scalar(v.z));}
__DEVICE__ float3 tfd(float3 r,int t){if(t==0)return tf709d(r);if(t==1)return tfl4d(r);if(t==2)return tfl3d(r);if(t==3)return tfs3d(r);if(t==4)return tfvld(r);if(t==5)return tflg10d(r);if(t==6)return tfdwd(r);if(t==7)return r;if(t==8)return tfc2d(r);if(t==9)return tfc3d(r);if(t==10)return tfdld(r);if(t==11)return r;if(t==12)return r;if(t==13)return tfapl(r);if(t==14)return tfcctd(r);if(t==15)return tfbmd5d(r);if(t==16)return tfflog2d(r);if(t==17)return tfnlogd(r);return r;}

// ---- TFs: encode (linear -> native transfer) ----
__DEVICE__ float3 tf709e(float3 v){float3 o;o.x=v.x<=0.018f?4.5f*v.x:1.099f*_powf(v.x,0.45f)-0.099f;o.y=v.y<=0.018f?4.5f*v.y:1.099f*_powf(v.y,0.45f)-0.099f;o.z=v.z<=0.018f?4.5f*v.z:1.099f*_powf(v.z,0.45f)-0.099f;return o;}
__DEVICE__ float3 tfl4e(float3 v){float a=LOGC4_A,b=LOGC4_B,c=LOGC4_C,s2=LOGC4_S2,t=LOGC4_T;float3 o;o.x=v.x>t?c+b*(_log10f(a*v.x+64.0f)/_log10f(2.0f)-6.0f)/14.0f:(v.x-t)/s2;o.y=v.y>t?c+b*(_log10f(a*v.y+64.0f)/_log10f(2.0f)-6.0f)/14.0f:(v.y-t)/s2;o.z=v.z>t?c+b*(_log10f(a*v.z+64.0f)/_log10f(2.0f)-6.0f)/14.0f:(v.z-t)/s2;return o;}
__DEVICE__ float3 tfl3e(float3 v){float3 o;o.x=v.x>LOGC3_CUT?LOGC3_C*_log10f(LOGC3_A*v.x+LOGC3_B)+LOGC3_D:LOGC3_E*v.x+LOGC3_F;o.y=v.y>LOGC3_CUT?LOGC3_C*_log10f(LOGC3_A*v.y+LOGC3_B)+LOGC3_D:LOGC3_E*v.y+LOGC3_F;o.z=v.z>LOGC3_CUT?LOGC3_C*_log10f(LOGC3_A*v.z+LOGC3_B)+LOGC3_D:LOGC3_E*v.z+LOGC3_F;return o;}
__DEVICE__ float3 tfs3e(float3 v){float a=0.19f,b=0.01f,c=261.5f,d=420.0f,e=171.2102946929f,f=1023.0f;float3 o;o.x=v.x<=0.01125f?(v.x*(e-95.0f)/0.01125f+95.0f)/f:(_log10f((v.x+b)/a)*c+d)/f;o.y=v.y<=0.01125f?(v.y*(e-95.0f)/0.01125f+95.0f)/f:(_log10f((v.y+b)/a)*c+d)/f;o.z=v.z<=0.01125f?(v.z*(e-95.0f)/0.01125f+95.0f)/f:(_log10f((v.z+b)/a)*c+d)/f;return o;}
__DEVICE__ float3 tfvle(float3 v){float cut=0.181f,b=0.00873f,c=0.241514f,d=0.598206f;float3 o;o.x=v.x<=(cut-0.125f)/5.6f?v.x*5.6f+0.125f:c*_log10f(v.x+b)+d;o.y=v.y<=(cut-0.125f)/5.6f?v.y*5.6f+0.125f:c*_log10f(v.y+b)+d;o.z=v.z<=(cut-0.125f)/5.6f?v.z*5.6f+0.125f:c*_log10f(v.z+b)+d;return o;}
__DEVICE__ float3 tflg10e(float3 v){float B=25.0f*(_sqrtf(4093.0f)-3.0f)/9.0f,A=1.0f/_log10f(B*184.32f+1.0f);return make_float3(v.x<0.0f?v.x*(A*B*0.4342944819f):A*_log10f(v.x*B+1.0f),v.y<0.0f?v.y*(A*B*0.4342944819f):A*_log10f(v.y*B+1.0f),v.z<0.0f?v.z*(A*B*0.4342944819f):A*_log10f(v.z*B+1.0f));}
__DEVICE__ float3 tfdwe(float3 v){float A=0.0075f,B=7.0f,C=0.07329248f,M=10.44426855f;float3 o;o.x=v.x<=DI_LIN_CUT?v.x*M:C*(_log2f(v.x+A)+B);o.y=v.y<=DI_LIN_CUT?v.y*M:C*(_log2f(v.y+A)+B);o.z=v.z<=DI_LIN_CUT?v.z*M:C*(_log2f(v.z+A)+B);return o;}
__DEVICE__ float3 tfc2e(float3 v){float k=0.092864125f,m=0.24136077f,n=87.09937546f;v=make_float3(v.x/0.9f,v.y/0.9f,v.z/0.9f);float3 o;o.x=v.x<0.0f?k-m*_log10f(-v.x*n+1.0f):k+m*_log10f(v.x*n+1.0f);o.y=v.y<0.0f?k-m*_log10f(-v.y*n+1.0f):k+m*_log10f(v.y*n+1.0f);o.z=v.z<0.0f?k-m*_log10f(-v.z*n+1.0f):k+m*_log10f(v.z*n+1.0f);return o;}
__DEVICE__ float clog3e1(float x){x=x/0.9f;if(x<CLOG3_LIN_MIN)return 0.12783901f-0.36726845f*_log10f(-x*14.98325f+1.0f);if(x<=CLOG3_LIN_MAX)return x*1.9754798f+0.12512219f;return 0.12240537f+0.36726845f*_log10f(x*14.98325f+1.0f);}
__DEVICE__ float3 tfc3e(float3 v){return make_float3(clog3e1(v.x),clog3e1(v.y),clog3e1(v.z));}
__DEVICE__ float3 tfdle(float3 v){float3 o;o.x=v.x<=(0.14f-0.0929f)/6.025f?v.x*6.025f+0.0929f:(_log10f(v.x*0.9892f+0.0108f)+2.27752f)/3.89616f;o.y=v.y<=(0.14f-0.0929f)/6.025f?v.y*6.025f+0.0929f:(_log10f(v.y*0.9892f+0.0108f)+2.27752f)/3.89616f;o.z=v.z<=(0.14f-0.0929f)/6.025f?v.z*6.025f+0.0929f:(_log10f(v.z*0.9892f+0.0108f)+2.27752f)/3.89616f;return o;}
__DEVICE__ float3 tfaple(float3 v){float3 o;o.x=v.x<=APPLE_R0?0.0f:v.x<APPLE_RT?APPLE_SIGMA*(v.x-APPLE_R0)*(v.x-APPLE_R0):APPLE_DELTA+APPLE_GAMMA*_log2f(v.x+APPLE_BETA);o.y=v.y<=APPLE_R0?0.0f:v.y<APPLE_RT?APPLE_SIGMA*(v.y-APPLE_R0)*(v.y-APPLE_R0):APPLE_DELTA+APPLE_GAMMA*_log2f(v.y+APPLE_BETA);o.z=v.z<=APPLE_R0?0.0f:v.z<APPLE_RT?APPLE_SIGMA*(v.z-APPLE_R0)*(v.z-APPLE_R0):APPLE_DELTA+APPLE_GAMMA*_log2f(v.z+APPLE_BETA);return o;}
__DEVICE__ float3 tfccte(float3 v){float A=10.5402377417f,B=0.0729055342f,XB=0.0078125f;float3 o;o.x=v.x<=XB?A*v.x+B:(_log2f(v.x)+9.72f)/17.52f;o.y=v.y<=XB?A*v.y+B:(_log2f(v.y)+9.72f)/17.52f;o.z=v.z<=XB?A*v.z+B:(_log2f(v.z)+9.72f)/17.52f;return o;}
__DEVICE__ float3 tfbmd5e(float3 v){float3 o;o.x=v.x<=BMD5_LIN_CUT?BMD5_D*v.x+BMD5_E:BMD5_A*(_log2f(v.x+BMD5_B)*LN2)+BMD5_C;o.y=v.y<=BMD5_LIN_CUT?BMD5_D*v.y+BMD5_E:BMD5_A*(_log2f(v.y+BMD5_B)*LN2)+BMD5_C;o.z=v.z<=BMD5_LIN_CUT?BMD5_D*v.z+BMD5_E:BMD5_A*(_log2f(v.z+BMD5_B)*LN2)+BMD5_C;return o;}
__DEVICE__ float3 tfflog2e(float3 v){float3 o;o.x=v.x>=FLOG2_CUT1?FLOG2_C*_log10f(FLOG2_A*v.x+FLOG2_B)+FLOG2_D:FLOG2_E*v.x+FLOG2_F;o.y=v.y>=FLOG2_CUT1?FLOG2_C*_log10f(FLOG2_A*v.y+FLOG2_B)+FLOG2_D:FLOG2_E*v.y+FLOG2_F;o.z=v.z>=FLOG2_CUT1?FLOG2_C*_log10f(FLOG2_A*v.z+FLOG2_B)+FLOG2_D:FLOG2_E*v.z+FLOG2_F;return o;}
__DEVICE__ float3 tfnloge(float3 v){float3 code;code.x=v.x<NLOG_ENC_CUT?650.0f*cbrt_s(v.x+0.0075f):150.0f*(_log2f(v.x)*LN2)+619.0f;code.y=v.y<NLOG_ENC_CUT?650.0f*cbrt_s(v.y+0.0075f):150.0f*(_log2f(v.y)*LN2)+619.0f;code.z=v.z<NLOG_ENC_CUT?650.0f*cbrt_s(v.z+0.0075f):150.0f*(_log2f(v.z)*LN2)+619.0f;return code/1023.0f;}
__DEVICE__ float3 tfe(float3 r,int t){if(t==0)return tf709e(r);if(t==1)return tfl4e(r);if(t==2)return tfl3e(r);if(t==3)return tfs3e(r);if(t==4)return tfvle(r);if(t==5)return tflg10e(r);if(t==6)return tfdwe(r);if(t==7)return r;if(t==8)return tfc2e(r);if(t==9)return tfc3e(r);if(t==10)return tfdle(r);if(t==11)return r;if(t==12)return r;if(t==13)return tfaple(r);if(t==14)return tfccte(r);if(t==15)return tfbmd5e(r);if(t==16)return tfflog2e(r);if(t==17)return tfnloge(r);return r;}

__DEVICE__ float3 encode_native_ei(float3 r,int t,int logc3idx){return t==2?tfl3e_ei(r,logc3idx):tfe(r,t);}
__DEVICE__ float3 decode_native_ei(float3 r,int t,int logc3idx){return t==2?tfl3d_ei(r,logc3idx):tfd(r,t);}




__DEVICE__ float smootherstep(float e0,float e1,float x){float span=e1-e0;if(span<=1e-12f)return x>=e1?1.0f:0.0f;x=clampf((x-e0)/span,0.0f,1.0f);return x*x*x*(x*(x*6.0f-15.0f)+10.0f);}

// ---- OKLab ----
__DEVICE__ float3 xyz_to_oklab(float3 xyz){float3 lms=mmul(X65_TO_OKLMS_C0,X65_TO_OKLMS_C1,X65_TO_OKLMS_C2,xyz);lms=make_float3(cbrt_s(lms.x),cbrt_s(lms.y),cbrt_s(lms.z));return mmul(O_C0,O_C1,O_C2,lms);}
__DEVICE__ float3 oklab_to_xyz(float3 lab){float3 lms=mmul(P_C0,P_C1,P_C2,lab);lms=make_float3(lms.x*lms.x*lms.x,lms.y*lms.y*lms.y,lms.z*lms.z*lms.z);return mmul(OKLMS3_TO_X65_C0,OKLMS3_TO_X65_C1,OKLMS3_TO_X65_C2,lms);}
__DEVICE__ float3 oklab_to_xyz_preserve_y_safe(float3 lab,float targetY){
  float3 out=oklab_to_xyz(lab);
  if(targetY<=1.0e-10f)return out;
  if(out.y<=1.0e-10f){
    float lo=0.0f,hi=1.0f;
    for(int i=0;i<20;i++){
      float mid=(lo+hi)*0.5f;
      float3 test=make_float3(lab.x,lab.y*mid,lab.z*mid);
      float y=oklab_to_xyz(test).y;
      if(y>targetY*1.0e-6f)lo=mid;else hi=mid;
    }
    lab.y*=lo;lab.z*=lo;out=oklab_to_xyz(lab);
  }
  if(out.y<=1.0e-12f)return make_float3(WHITE_D65.x*targetY,targetY,WHITE_D65.z*targetY);
  float k=targetY/out.y;
  return out*make_float3(k,k,k);
}

// ---- Domain routing helpers ----
__DEVICE__ float3 xyz_to_native_linear(float3 xyz,int g){return g==8?mmul(X65_TO_AP1_C0,X65_TO_AP1_C1,X65_TO_AP1_C2,xyz):x2g(g,xyz);}
__DEVICE__ float3 native_linear_to_xyz(float3 rgb,int g){return g==8?mmul(AP1_TO_X65_C0,AP1_TO_X65_C1,AP1_TO_X65_C2,rgb):g2x(g,rgb);}

// Linear Gain WB: derive per-channel native-linear gains from the requested source white,
// normalize green to unity so white balance does not hide an arbitrary global exposure change,
// then apply the gains before any creative tone operation. Negative scene-linear samples remain signed.
__DEVICE__ float wb_safe_ratio(float dst,float src){if(src<=1.0e-6f||dst<=1.0e-6f)return 1.0f;return clampf(dst/src,0.125f,8.0f);}
__DEVICE__ float3 linear_gain_wb_native(float3 rgb,int g,float temp_value,float tint_value){
  if(_fabs(temp_value)<=1e-7f&&_fabs(tint_value)<=1e-7f)return rgb;
  float3 source_white=wb_source_white_xyz(temp_value,tint_value);
  float3 src_rgb=xyz_to_native_linear(source_white,g);
  float3 dst_rgb=xyz_to_native_linear(WHITE_D65,g);
  float3 gains=make_float3(wb_safe_ratio(dst_rgb.x,src_rgb.x),wb_safe_ratio(dst_rgb.y,src_rgb.y),wb_safe_ratio(dst_rgb.z,src_rgb.z));
  float norm=gains.y>1.0e-6f?1.0f/gains.y:1.0f;
  gains=make_float3(clampf(gains.x*norm,0.125f,8.0f),1.0f,clampf(gains.z*norm,0.125f,8.0f));
  return make_float3(rgb.x*gains.x,rgb.y,gains.z*rgb.z);
}
__DEVICE__ float3 native_rgb_balance_xyz(float3 xyz,int g,float r_stops,float g_stops,float b_stops){
  float3 rgb=xyz_to_native_linear(xyz,g);
  rgb.x*=_powf(2.0f,r_stops);
  rgb.y*=_powf(2.0f,g_stops);
  rgb.z*=_powf(2.0f,b_stops);
  return native_linear_to_xyz(rgb,g);
}


// ---- Primera v0.5.5 tone helpers (verbatim equations) ----
__DEVICE__ float primera_soft_black_point(float x, float bp, float knee) {
    if (x <= 0.0f) return x;
    float corrected = x - bp;
    if (corrected >= knee) return corrected;
    return knee * _expf(corrected / knee - 1.0f);
}

__DEVICE__ float primera_shadow_fill(float x, float gain, float mid) {
    if (x <= 0.0f) return x;
    if (x >= mid) return x;
    float t = x / mid;
    float blend = t * t * (3.0f - 2.0f * t);
    return x * (gain + (1.0f - gain) * blend);
}

__DEVICE__ float primera_highlight_gain(float x, float gain, float mid) {
    if (x <= mid) return x;
    if (x >= 1.0f) return x;
    float t = (x - mid) / (1.0f - mid);
    float blend = t * t * (3.0f - 2.0f * t);
    return x * (1.0f + (gain - 1.0f) * blend);
}

__DEVICE__ float primera_soft_highlight(float x, float amount, float mid) {
    if (x <= 0.0f) return x;
    float knee_amount = _fminf(amount, 1.0f);
    float strength = 1.0f + _fmaxf(amount - 1.0f, 0.0f) * 2.0f;
    float knee = 1.0f - knee_amount * (1.0f - mid);
    if (x <= knee) return x;
    float range = 1.0f - knee;
    float tt = (x - knee) / range * strength;
    return knee + range * _tanhf(tt) / strength;
}

__DEVICE__ float primera_rolling_contrast(float x, float contrast, float pivot) {
    if (x <= 0.0f) return x;
    if (x >= 1.0f) return x;
    if (x <= pivot) {
        return _powf(x / pivot, contrast) * pivot;
    } else {
        float inv = 1.0f - x;
        float inv_pivot = 1.0f - pivot;
        return 1.0f - _powf(inv / inv_pivot, contrast) * inv_pivot;
    }
}

// Apply Primera's encoded-domain Contrast/Shadows/Highlights/Roll Off exactly
// using Keystone's selected native transfer function.
__DEVICE__ float3 apply_primera_encoded_tone(
    float3 native_lin,
    int transfer_id,
    int logc3idx,
    float contrast_value,
    float pivot_offset,
    float shadows_value,
    float highlights_value,
    float rolloff_value)
{
    float3 code=encode_native_ei(native_lin,transfer_id,logc3idx);

    float3 mid_lin=make_float3(0.18f,0.18f,0.18f);
    float3 mid_code3=encode_native_ei(mid_lin,transfer_id,logc3idx);
    float mid=(mid_code3.x+mid_code3.y+mid_code3.z)*(1.0f/3.0f);

    if (contrast_value != 1.0f || pivot_offset != 0.0f) {
        float pivot = mid + pivot_offset;
        pivot = _fmaxf(0.01f, _fminf(pivot, 0.99f));
        float con = (contrast_value != 1.0f) ? contrast_value : 1.0f;
        code.x = primera_rolling_contrast(code.x, con, pivot);
        code.y = primera_rolling_contrast(code.y, con, pivot);
        code.z = primera_rolling_contrast(code.z, con, pivot);
    }

    if (shadows_value != 0.0f) {
        float shd_gain = _powf(2.0f, shadows_value);
        code.x = primera_shadow_fill(code.x, shd_gain, mid);
        code.y = primera_shadow_fill(code.y, shd_gain, mid);
        code.z = primera_shadow_fill(code.z, shd_gain, mid);
    }

    if (highlights_value != 0.0f) {
        float hi_gain = _powf(2.0f, highlights_value);
        code.x = primera_highlight_gain(code.x, hi_gain, mid);
        code.y = primera_highlight_gain(code.y, hi_gain, mid);
        code.z = primera_highlight_gain(code.z, hi_gain, mid);
    }

    if (rolloff_value > 0.0f) {
        code.x = primera_soft_highlight(code.x, rolloff_value, mid);
        code.y = primera_soft_highlight(code.y, rolloff_value, mid);
        code.z = primera_soft_highlight(code.z, rolloff_value, mid);
    }

    return decode_native_ei(code,transfer_id,logc3idx);
}

// ---- Native destination-gamut creative boundary ----
// Margin = min(native RGB channel) / max(abs(native RGB channel)); exposure-invariant.
// This is evaluated in the actual destination/native gamut, never in a universal AWG4 cube.
__DEVICE__ float native_gamut_margin_from_rgb(float3 rgb){float maxabs=_fmaxf(_fabs(rgb.x),_fmaxf(_fabs(rgb.y),_fabs(rgb.z)));if(maxabs<=1e-12f)return 1.0f;float minc=_fminf(rgb.x,_fminf(rgb.y,rgb.z));return clampf(minc/maxabs,-1.0f,1.0f);}
__DEVICE__ float native_gamut_margin_oklab(float3 lab,int g){return native_gamut_margin_from_rgb(xyz_to_native_linear(oklab_to_xyz(lab),g));}
__DEVICE__ float vibrance_activity(float3 lab,float margin){float L=lab.x;float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);if(C<=VIBRANCE_ABS_C_MIN||C<=1e-8f||_fabs(L)<=1e-6f)return 0.0f;float q=C/_fmaxf(_fabs(L),1e-6f);float q_gate=smootherstep(VIBRANCE_Q0,VIBRANCE_Q1,q);float margin_gate=smootherstep(VIBRANCE_MARGIN0,VIBRANCE_MARGIN1,margin);return q_gate*margin_gate;}
__DEVICE__ float limit_positive_chroma_scale(float3 lab,float proposed_scale,float min_margin,int g){if(proposed_scale<=1.0f)return proposed_scale;float current_margin=native_gamut_margin_oklab(lab,g);if(current_margin<=min_margin)return 1.0f;float3 candidate=make_float3(lab.x,lab.y*proposed_scale,lab.z*proposed_scale);if(native_gamut_margin_oklab(candidate,g)>=min_margin)return proposed_scale;float lo=1.0f,hi=proposed_scale;for(int i=0;i<VIBRANCE_SEARCH_ITERS;i++){float mid=(lo+hi)*0.5f;float3 test_lab=make_float3(lab.x,lab.y*mid,lab.z*mid);if(native_gamut_margin_oklab(test_lab,g)>=min_margin)lo=mid;else hi=mid;}return lo;}
__DEVICE__ float3 apply_vibrance(float3 lab,float vibr,int g){if(_fabs(vibr)<=1e-7f)return lab;float L=lab.x;float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);if(_fabs(L)<=1e-6f||C<=1e-8f)return lab;float margin=native_gamut_margin_oklab(lab,g);float activity=vibrance_activity(lab,margin);float v_eff=signed_square(vibr);float scale=_fmaxf(1.0f+VIBRANCE_MAX_CHANGE*v_eff*activity,0.0f);if(v_eff>0.0f)scale=limit_positive_chroma_scale(lab,scale,VIBRANCE_MIN_MARGIN,g);lab.y*=scale;lab.z*=scale;return lab;}

// ---- OpenDRT-style Creative White ----
// Exact D65->creative-white CAT matrix coefficients published in OpenDRT v1.1.0.
// IMPORTANT: coefficients below are multiplied as ROWS, matching OpenDRT's vdot().
// RC22 incorrectly fed those rows into Keystone's column-vector mmul helper.
//
// OpenDRT applies Creative White post-tonescale and blends it by:
//     cwp_f = pow(tsn, 2*cwp_lm)
// with default cwp_lm = 0.25.
// Keystone is pre-ODT, so there is no true OpenDRT 'tsn'. We use a bounded,
// monotonic scene-intensity proxy that maps 18% scene gray to 0.10 and approaches
// 1.0 in strong highlights. This preserves OpenDRT's key behavior: shadows/mids
// are less affected and whites/highlights converge most strongly to Creative White.
__DEVICE__ float3 odrt_rowmul(
    float3 v,
    float r00,float r01,float r02,
    float r10,float r11,float r12,
    float r20,float r21,float r22)
{
  return make_float3(
    r00*v.x+r01*v.y+r02*v.z,
    r10*v.x+r11*v.y+r12*v.z,
    r20*v.x+r21*v.y+r22*v.z);
}

__DEVICE__ float3 odrt_cat_d65(float3 xyz,int cwp){
  if(cwp==0) // D93
    return odrt_rowmul(xyz,
      0.95703423023223877f,-0.0247171502560377121f,0.0624028593301773071f,
      -0.0179296955466270447f,0.990019857883453369f,0.0248119533061981201f,
      0.00127589143812656403f,0.00427919067442417058f,1.29345715045928955f);
  if(cwp==1) // D75
    return odrt_rowmul(xyz,
      0.981001079082489014f,-0.0116619253531098366f,0.0265614092350006104f,
      -0.00843488052487373352f,0.996506094932556152f,0.0105696544051170349f,
      0.000552809564396739006f,0.00179840810596942902f,1.12374722957611084f);
  if(cwp==2)return xyz; // D65
  if(cwp==3) // D60
    return odrt_rowmul(xyz,
      1.01182246208190918f,0.00778879318386316299f,-0.0157783031463623047f,
      0.00561682833358645439f,1.00150644779205322f,-0.00628517568111419678f,
      -0.000335735734552145004f,-0.0010509500280022619f,0.927366673946380615f);
  if(cwp==4) // D55
    return odrt_rowmul(xyz,
      1.02585089206695557f,0.0179439820349216461f,-0.0332137793302536011f,
      0.0129133854061365128f,1.00214779376983643f,-0.0132421031594276428f,
      -0.000719940289855003032f,-0.00218106806278228803f,0.84868013858795166f);
  if(cwp==5) // D50
    return odrt_rowmul(xyz,
      1.04257404804229736f,0.03089117631316185f,-0.052812620997428894f,
      0.0221935361623764038f,1.00185668468475342f,-0.0210737623274326324f,
      -0.00116488314233720303f,-0.00342052709311246915f,0.761789083480834961f);
  return xyz;
}

__DEVICE__ float odrt_scene_tsn(float Y){
  if(Y<=0.0f)return 0.0f;
  // k=1.62 gives tsn(0.18)=0.10 exactly.
  return clampf(Y/(Y+1.62f),0.0f,1.0f);
}

__DEVICE__ float3 odrt_creative_white_preodt(float3 xyz,int cwp){
  if(cwp==2||xyz.y<=1.0e-10f)return xyz;

  float3 adapted=odrt_cat_d65(xyz,cwp);

  // OpenDRT default Creative White Limit / cwp_lm is 0.25:
  // cwp_f = pow(tsn, 0.5)
  float tsn=odrt_scene_tsn(xyz.y);
  float cwp_f=_sqrtf(tsn);

  return xyz+(adapted-xyz)*make_float3(cwp_f,cwp_f,cwp_f);
}

// ---- Color Volume / luma-axis gamut compression ----
// The native gamut is scene-referred and therefore has no meaningful fixed upper
// RGB ceiling before the ODT. We consequently measure the chromaticity boundary
// by the first native-linear channel to reach zero while moving away from the
// neutral luma axis. This is exposure-relative, hue-dependent, and does NOT clamp
// extended highlights to 1.0.

__DEVICE__ float cv_native_boundary_scale(float3 rgb,float Y){
  float3 gray=make_float3(Y,Y,Y);
  float3 d=rgb-gray;
  float s=1.0e10f;
  const float eps=1.0e-7f;
  if(d.x<-eps)s=_fminf(s,Y/(-d.x));
  if(d.y<-eps)s=_fminf(s,Y/(-d.y));
  if(d.z<-eps)s=_fminf(s,Y/(-d.z));
  return _fmaxf(s,0.0f);
}

// Ratio of current chroma to the hue-dependent positive-primary boundary.
// <1 = inside native chromaticity gamut, 1 = boundary, >1 = outside.
__DEVICE__ float cv_native_stress_ratio(float3 xyz,int g){
  float Y=xyz.y;
  if(Y<=1.0e-10f)return 0.0f;
  float3 rgb=xyz_to_native_linear(xyz,g);
  float s=cv_native_boundary_scale(rgb,Y);
  if(s>=1.0e9f)return 0.0f;
  return 1.0f/_fmaxf(s,1.0e-6f);
}

// C1-continuous soft compression: unchanged at/below threshold and asymptotically
// approaches the native boundary instead of clipping against it.
__DEVICE__ float cv_soft_ratio(float ratio,float threshold){
  float th=clampf(threshold,0.50f,0.98f);
  if(ratio<=th)return ratio;
  float span=_fmaxf(1.0f-th,1.0e-6f);
  float x=(ratio-th)/span;
  return th+span*(1.0f-_expf(-x));
}

__DEVICE__ float3 cv_scale_from_luma_axis(float3 xyz,int g,float scale){
  float Y=xyz.y;
  if(Y<=1.0e-10f)return xyz;
  float3 rgb=xyz_to_native_linear(xyz,g);
  float3 gray=make_float3(Y,Y,Y);
  float3 out=gray+(rgb-gray)*make_float3(scale,scale,scale);
  return native_linear_to_xyz(out,g);
}

// Restore as much of the original perceptual hue angle as the native positivity
// boundary permits. This runs AFTER the luma-axis compression, so hue correction
// cannot silently reintroduce a negative-primary failure.
__DEVICE__ float3 cv_restore_hue_safe(float3 original_xyz,float3 compressed_xyz,int g){
  if(original_xyz.y<=1.0e-10f||compressed_xyz.y<=1.0e-10f)return compressed_xyz;

  float3 o=xyz_to_oklab(original_xyz);
  float3 c=xyz_to_oklab(compressed_xyz);
  float Co=_sqrtf(o.y*o.y+o.z*o.z);
  float Cc=_sqrtf(c.y*c.y+c.z*c.z);
  if(Co<=1.0e-8f||Cc<=1.0e-8f)return compressed_xyz;

  float h=_atan2f(o.z,o.y);
  float3 target_lab=make_float3(c.x,Cc*_cosf(h),Cc*_sinf(h));
  float3 target_xyz=oklab_to_xyz_preserve_y_safe(target_lab,compressed_xyz.y);
  float3 trgb=xyz_to_native_linear(target_xyz,g);

  if(trgb.x>=-1.0e-7f&&trgb.y>=-1.0e-7f&&trgb.z>=-1.0e-7f)return target_xyz;

  float lo=0.0f,hi=1.0f;
  for(int i=0;i<10;i++){
    float m=(lo+hi)*0.5f;
    float3 test=compressed_xyz+(target_xyz-compressed_xyz)*make_float3(m,m,m);
    float3 rgb=xyz_to_native_linear(test,g);
    if(rgb.x>=-1.0e-7f&&rgb.y>=-1.0e-7f&&rgb.z>=-1.0e-7f)lo=m;else hi=m;
  }
  return compressed_xyz+(target_xyz-compressed_xyz)*make_float3(lo,lo,lo);
}

// Boundary-aware luma-axis gamut compression.
// Luminance is preserved because the operation scales only the chroma vector
// around an equal-RGB neutral with the same scene Y.
__DEVICE__ float3 cv_apply_gamut_compression(float3 xyz,int g,float amount,float threshold){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-7f||xyz.y<=1.0e-10f)return xyz;

  float ratio=cv_native_stress_ratio(xyz,g);
  if(ratio<=threshold)return xyz;

  float desired=cv_soft_ratio(ratio,threshold);
  float final_ratio=ratio+(desired-ratio)*a;
  float scale=final_ratio/_fmaxf(ratio,1.0e-6f);

  float3 compressed=cv_scale_from_luma_axis(xyz,g,scale);
  return cv_restore_hue_safe(xyz,compressed,g);
}

// Highlight color-volume compression. No display peak is assumed. Instead the
// control uses scene exposure and the same hue-dependent native boundary.
// A color safely below the requested purity limit does not move.
__DEVICE__ float3 cv_apply_highlight_volume(
    float3 xyz,int g,float amount,float purity,float start_ev)
{
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-7f||xyz.y<=1.0e-10f)return xyz;

  float ev=_log2f(xyz.y/0.18f);
  float hi=smootherstep(start_ev,start_ev+3.5f,ev);
  if(hi<=1.0e-8f)return xyz;

  float ratio=cv_native_stress_ratio(xyz,g);
  float cap=clampf(purity,0.30f,1.00f);
  if(ratio<=cap)return xyz;

  // Smoothly approach the requested purity cap; do not hard-clip chroma.
  float excess=(ratio-cap)/_fmaxf(1.0f-cap,1.0e-6f);
  float engage=smootherstep(0.0f,1.0f,excess);
  float target=cap+(ratio-cap)*(1.0f-engage);
  float strength=a*hi;
  float final_ratio=ratio+(target-ratio)*strength;
  float scale=final_ratio/_fmaxf(ratio,1.0e-6f);

  float3 compressed=cv_scale_from_luma_axis(xyz,g,scale);
  return cv_restore_hue_safe(xyz,compressed,g);
}

__DEVICE__ float ks_cv_highlight_stress(float3 xyz,int g,float purity,float start_ev){
  if(xyz.y<=1.0e-10f)return 0.0f;
  float ev=_log2f(xyz.y/0.18f);
  float hi=smootherstep(start_ev,start_ev+3.5f,ev);
  float ratio=cv_native_stress_ratio(xyz,g);
  float cap=clampf(purity,0.30f,1.00f);
  float sat=smootherstep(cap*0.75f,cap,ratio);
  return clampf(hi*sat,0.0f,1.0f);
}

__DEVICE__ float cv_compression_amount(float3 before_xyz,float3 after_xyz,int g){
  if(before_xyz.y<=1.0e-10f)return 0.0f;
  float Y=before_xyz.y;
  float3 b=xyz_to_native_linear(before_xyz,g)-make_float3(Y,Y,Y);
  float3 a=xyz_to_native_linear(after_xyz,g)-make_float3(Y,Y,Y);
  float nb=_sqrtf(b.x*b.x+b.y*b.y+b.z*b.z);
  float na=_sqrtf(a.x*a.x+a.y*a.y+a.z*a.z);
  if(nb<=1.0e-10f)return 0.0f;
  return clampf(1.0f-na/nb,0.0f,1.0f);
}

__DEVICE__ float3 cv_debug_mask(float m,int g,int tf,int logc3idx){
  float v=clampf(m,0.0f,1.0f);
  float3 neutral=make_float3(v,v,v);
  return encode_native_ei(neutral,tf,logc3idx);
}


__DEVICE__ float3 compress_to_gamut(float3 rgb,float luminance){
  if(luminance<=0.0f)return rgb;
  float scale=1.0f;
  float3 delta=rgb-make_float3(luminance,luminance,luminance);
  if(rgb.x<0.0f&&delta.x<0.0f)scale=_fminf(scale,luminance/-delta.x);
  if(rgb.y<0.0f&&delta.y<0.0f)scale=_fminf(scale,luminance/-delta.y);
  if(rgb.z<0.0f&&delta.z<0.0f)scale=_fminf(scale,luminance/-delta.z);
  scale=_fmaxf(_fminf(scale,1.0f),0.0f);
  return make_float3(luminance+delta.x*scale,luminance+delta.y*scale,luminance+delta.z*scale);
}

// White cleanup is intentionally NOT a look transform. It only reduces chroma
// in bright, already-near-neutral colors while preserving scene Y. This is a
// luminance-preserving white-clean operation: no palette matrix, hue rotation,
// Technicolor crosstalk, or global saturation change is present. Saturated
// highlights are protected by the relative-chroma gate.
__DEVICE__ float3 clean_neutral_highlights_xyz(float3 xyz,float amount){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-7f||xyz.y<=1.0e-10f)return xyz;

  float3 lab=xyz_to_oklab(xyz);
  float L=lab.x;
  float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  if(_fabs(L)<=1.0e-7f||C<=1.0e-10f)return xyz;

  // Stronger real-world white selector. Begin engaging slightly below middle-gray
  // and reach full tonal eligibility by +1 EV. This lets practical white objects
  // become fully neutral instead of being limited by a half-strength brightness mask.
  float ev=_log2f(_fmaxf(xyz.y,1.0e-10f)/0.18f);
  float white_gate=smootherstep(-0.50f,1.00f,ev);

  // Full cleanup is allowed for mildly contaminated near-whites through relC .08.
  // More colorful highlights roll off smoothly, with strong color protected by .30.
  float relC=C/_fmaxf(_fabs(L),1.0e-6f);
  float neutral_gate=1.0f-smootherstep(0.080f,0.300f,relC);

  // Stronger perceptual slider response: 0.5 -> 0.75 effective strength, while
  // preserving exact 0 and 1 endpoints.
  float a_eff=1.0f-(1.0f-a)*(1.0f-a);
  float clean=clampf(a_eff*white_gate*neutral_gate,0.0f,1.0f);
  if(clean<=1.0e-7f)return xyz;
  lab.y*=1.0f-clean;
  lab.z*=1.0f-clean;
  return oklab_to_xyz_preserve_y_safe(lab,xyz.y);
}


// Black cleanup mirrors the white-clean idea at the opposite end of the scene
// range. It only reduces chroma in deep, already-near-neutral shadows while
// preserving scene Y. The L floor in the chroma ratio is intentional: without it,
// tiny RGB contamination near black can look artificially "high saturation" and
// prevent the selector from engaging.
__DEVICE__ float3 clean_neutral_shadows_xyz(float3 xyz,float amount){
  float a=clampf(amount,0.0f,1.0f);
  if(a<=1.0e-7f||xyz.y<=1.0e-10f)return xyz;

  float3 lab=xyz_to_oklab(xyz);
  float L=lab.x;
  float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  if(_fabs(L)<=1.0e-7f||C<=1.0e-10f)return xyz;

  // Stronger black selector. Deep shadows are fully eligible by -2 EV and the
  // effect fades smoothly out through middle gray instead of stopping at -1 EV.
  float ev=_log2f(_fmaxf(xyz.y,1.0e-10f)/0.18f);
  float black_gate=1.0f-smootherstep(-2.0f,0.0f,ev);

  // Full cleanup is allowed for mildly contaminated near-blacks through relC .06.
  // More colorful shadows are increasingly protected, reaching full protection by .30.
  float relC=C/_fmaxf(_fabs(L),0.12f);
  float neutral_gate=1.0f-smootherstep(0.060f,0.300f,relC);

  float a_eff=1.0f-(1.0f-a)*(1.0f-a);
  float clean=clampf(a_eff*black_gate*neutral_gate,0.0f,1.0f);
  if(clean<=1.0e-7f)return xyz;
  lab.y*=1.0f-clean;
  lab.z*=1.0f-clean;
  return oklab_to_xyz_preserve_y_safe(lab,xyz.y);
}


// ---- Technical encode-domain guard ----
// This is NOT creative gamut mapping. It only prevents pathological imaginary RGB
// ratios produced by extreme combinations from exploding vendor log encoders.
// Normal extended/negative values are preserved. For positive scene Y, channel
// excursions are bounded only when they become catastrophic for downstream encoders; ordinary negative values remain extended.
__DEVICE__ float3 technical_encode_domain_guard(float3 rgb,float Y){
  if(Y<=1.0e-10f){
    float mn=_fminf(rgb.x,_fminf(rgb.y,rgb.z));
    if(mn<-2.0f){float k=(-2.0f)/mn;return rgb*make_float3(k,k,k);}
    return rgb;
  }
  float3 n=make_float3(Y,Y,Y);
  float3 d=rgb-n;
  float s=1.0f;
  // Preserve ordinary extended negatives. Only catastrophic excursions below -2.0
  // scene-linear (or the looser -16Y bound for very dark values) are constrained.
  float lo=_fmaxf(-2.0f,-16.0f*Y);
  float hi=64.0f*Y;
  if(rgb.x<lo&&d.x<0.0f) s=_fminf(s,(lo-Y)/d.x);
  if(rgb.y<lo&&d.y<0.0f) s=_fminf(s,(lo-Y)/d.y);
  if(rgb.z<lo&&d.z<0.0f) s=_fminf(s,(lo-Y)/d.z);
  if(rgb.x>hi&&d.x>0.0f) s=_fminf(s,(hi-Y)/d.x);
  if(rgb.y>hi&&d.y>0.0f) s=_fminf(s,(hi-Y)/d.y);
  if(rgb.z>hi&&d.z>0.0f) s=_fminf(s,(hi-Y)/d.z);
  s=clampf(s,0.0f,1.0f);
  return n+d*make_float3(s,s,s);
}

// ---- Input Gamut Heal: ACES 1.3 RGC core in AP1 wrapper ----
// Optional technical input repair only; AP1 is a local reference-operator domain, not Keystone's working space.
__DEVICE__ float rgc_comp_dist(float dn,float t,float ss){if(dn<t)return dn;float x=(dn-t)/ss;float dp=_powf(_fmaxf(x,0.0f),1.2f);return t+(dn-t)/_powf(1.0f+dp,1.0f/1.2f);}
__DEVICE__ float3 rgc_core_ap1(float3 rgb){float A=_fmaxf(rgb.x,_fmaxf(rgb.y,rgb.z));float aa=_fabs(A);if(aa<=1e-12f)return rgb;float dnR=(A-rgb.x)/aa,dnG=(A-rgb.y)/aa,dnB=(A-rgb.z)/aa;float dcR=rgc_comp_dist(dnR,0.815f,0.327301877468f);float dcG=rgc_comp_dist(dnG,0.803f,0.285938028927f);float dcB=rgc_comp_dist(dnB,0.880f,0.146821457838f);return make_float3(A-dcR*aa,A-dcG*aa,A-dcB*aa);}
__DEVICE__ float3 input_gamut_heal_xyz(float3 xyz){float3 ap1=mmul(X65_TO_AP1_C0,X65_TO_AP1_C1,X65_TO_AP1_C2,xyz);ap1=rgc_core_ap1(ap1);return mmul(AP1_TO_X65_C0,AP1_TO_X65_C1,AP1_TO_X65_C2,ap1);}

// ---- Scene-stop Midtones ----
// Primary Contrast is handled separately by apply_resolve_style_contrast_xyz().
// HDR-safe Lift / Gamma / Gain in scene stops. Unlike 0-1 display-referred primaries,
// these masks are defined around 18% scene grey and remain valid for values far above 1.0.
// The three ranges overlap deliberately, matching the useful grading behavior of primary
// Lift/Gamma/Gain without clipping or normalizing HDR scene-linear values.
// ---- Dynamic Range ----
// Monotonic logarithmic shoulder in scene-stop space. The derivative is 1.0 at the
// knee and remains positive above it, so highlight ordering cannot invert.
// Scene-stop range repair. All changes are luminance-only XYZ scaling, preserving
// positive-Y chromaticity. Shadow Recovery uses a broad smooth window so the
// deepest blacks (< -9 EV from 18% grey) remain anchored and the mapping remains
// monotonic even at 1.0. Highlight and specular stages use monotonic log shoulders.
// ---- Skin helpers ----

__DEVICE__ float deg_to_rad(float d){return d*(2.0f*PI)/360.0f;}
__DEVICE__ float mod2(float x,float y){float r=_fmod(x,y);if(r<0.0f)r+=y;if(r>=y)r-=y;return r;}
__DEVICE__ float skin_alpha(float h,float center){const float sm=5.0f;float w0=_expf(sm*_cosf(h-0.5102284f));float w1=_expf(sm*_cosf(h-center));float w2=_expf(sm*_cosf(h-1.9158353f));float w3=_expf(sm*_cosf(h-2.4870127f));float w4=_expf(sm*_cosf(h-3.3993594f));float w5=_expf(sm*_cosf(h-4.6085770f));float w6=_expf(sm*_cosf(h-5.7310226f));float d=w0+w1+w2+w3+w4+w5+w6;return d>1e-12f?w1/d:0.0f;}

// Output-clean skin protection uses the same perceptual hue selector and Skin Target
// as Keystone's skin tools. It intentionally requires some chroma, so true neutral
// whites, grays, and blacks are not accidentally protected just because hue is unstable
// near the achromatic axis.
__DEVICE__ float output_skin_mask_xyz(float3 xyz,float target_deg){
  if(xyz.y<=1.0e-10f)return 0.0f;
  float3 lab=xyz_to_oklab(xyz);
  float L=lab.x;
  float C=_sqrtf(lab.y*lab.y+lab.z*lab.z);
  if(C<=1.0e-8f)return 0.0f;

  float h=mod2(_atan2f(lab.z,lab.y),2.0f*PI);
  float center=SKIN_BASE_CENTER+deg_to_rad(target_deg);
  float hue_sel=skin_alpha(h,center);

  // Reuse the established Keystone skin lightness window, but keep the chroma
  // threshold slightly softer so pale skin highlights remain protected.
  float light_gate=smootherstep(0.02f,0.18f,L)*(1.0f-smootherstep(1.0f,1.5f,L));
  float chroma_gate=smootherstep(0.008f,0.060f,C);

  // Boost the existing selector into a practical protection mask without changing
  // its hue center/topology. Clamp prevents any over-protection.
  return clampf(1.35f*hue_sel*light_gate*chroma_gate,0.0f,1.0f);
}

// ---- Exact ME_Desatch compatibility module ----
// This intentionally operates in the encoded RGB presented to the DCTL, matching
// the referenced standalone DCTL when placed after Keystone in a node chain.
__DEVICE__ float3 me_rgb_to_cone(float3 rgb){
  const float pi=3.14159265359f;
  float rtr=rgb.x*0.81649658f+rgb.y*-0.40824829f+rgb.z*-0.40824829f;
  float rtg=rgb.y*0.70710678f+rgb.z*-0.70710678f;
  float rtb=rgb.x*0.57735027f+rgb.y*0.57735027f+rgb.z*0.57735027f;
  float art=_atan2f(rtg,rtr);
  float sphr=_sqrtf(rtr*rtr+rtg*rtg+rtb*rtb);
  float spht=art<0.0f?art+2.0f*3.141592653589f:art;
  float sphp=_atan2f(_sqrtf(rtr*rtr+rtg*rtg),rtb);
  float huecoef1=1.0f/(2.0f-(0.78539816f/0.61547971f));
  float huecoef2=2.0f*sphp*_sinf((2.0f*pi/3.0f)-_fmod(spht,(pi/3.0f)))/1.7320508075688f;
  float huemag=(_acosf(_cosf(3.0f*spht+pi))/(pi*huecoef1)+((0.78539816f/0.61547971f)-1.0f))*huecoef2;
  float satmag=_sinf(huemag+0.61547971f);
  return make_float3(sphr*satmag,spht*0.15915494309189535f,sphp*1.0467733744265997f);
}

__DEVICE__ float3 me_cone_to_rgb(float3 sph){
  const float pi=3.14159265359f;
  sph.y*=6.283185307179586f;
  sph.z*=0.9553166181245093f;
  float huecoef1=1.0f/(2.0f-(0.78539816f/0.61547971f));
  float huecoef2=2.0f*sph.z*_sinf((2.0f*pi/3.0f)-_fmod(sph.y,(pi/3.0f)))/1.7320508075688f;
  float huemag=(_acosf(_cosf(3.0f*sph.y+pi))/(pi*huecoef1)+((0.78539816f/0.61547971f)-1.0f))*huecoef2;
  float satmagsp=_sinf(huemag+0.61547971f);
  sph.x*=1.0f/satmagsp;
  float ctr=sph.x*_sinf(sph.z)*_cosf(sph.y);
  float ctg=sph.x*_sinf(sph.z)*_sinf(sph.y);
  float ctb=sph.x*_cosf(sph.z);
  return make_float3(
    ctr*0.81649658f+ctb*0.57735027f,
    ctr*-0.40824829f+ctg*0.70710678f+ctb*0.57735027f,
    ctr*-0.40824829f+ctg*-0.70710678f+ctb*0.57735027f);
}

__DEVICE__ float3 apply_me_desatch_exact(float3 rgb,float gs,float rs,float grs,float bs,float cs,float ms,float ys){
  float3 cone=me_rgb_to_cone(rgb);
  float radius=cone.x;
  float hue=cone.y;
  float phi=cone.z;
  const float rad=0.1666f;

  radius=radius*(gs*phi+1.0f);

  if(hue<=rad){
    float d=_fabs(hue);
    float off=(d/rad)-1.0f;
    radius=radius*(rs*-off*phi+1.0f);
  }
  if(hue>=1.0f-rad){
    float d=_fabs(hue-1.0f);
    float off=(d/rad)-1.0f;
    radius=radius*(rs*-off*phi+1.0f);
  }

  if(hue>=0.333f-rad&&hue<=0.333f+rad){
    float d=_fabs(hue-0.333f);float off=(d/rad)-1.0f;
    radius=radius*(grs*-off*phi+1.0f);
  }
  if(hue>=0.666f-rad&&hue<=0.666f+rad){
    float d=_fabs(hue-0.666f);float off=(d/rad)-1.0f;
    radius=radius*(bs*-off*phi+1.0f);
  }
  if(hue>=0.4999f-rad&&hue<=0.4999f+rad){
    float d=_fabs(hue-0.4999f);float off=(d/rad)-1.0f;
    radius=radius*(cs*-off*phi+1.0f);
  }
  if(hue>=0.8333f-rad&&hue<=0.8333f+rad){
    float d=_fabs(hue-0.8333f);float off=(d/rad)-1.0f;
    radius=radius*(ms*-off*phi+1.0f);
  }
  if(hue>=0.1666f-rad&&hue<=0.1666f+rad){
    float d=_fabs(hue-0.1666f);float off=(d/rad)-1.0f;
    radius=radius*(ys*-off*phi+1.0f);
  }

  return me_cone_to_rgb(make_float3(radius,hue,phi));
}


__DEVICE__ float3 transform(int p_Width,int p_Height,int p_X,int p_Y,float p_R,float p_G,float p_B){
  // Clamp all parameters to ranges that mirror DEFINE_UI_PARAMS.
  float c_temp=clampf(temp,-100.0f,100.0f), c_tint=clampf(tint,-100.0f,100.0f);
  float c_p_exposure=clampf(p_exposure,-6.0f,6.0f);
  float c_p_bp=clampf(p_bp,-0.05f,0.05f);
  float c_p_contrast=clampf(p_contrast,0.5f,2.0f);
  float c_p_pivot=clampf(p_pivot_offset,-0.2f,0.2f);
  float c_p_shadows=clampf(p_shadows,-1.0f,1.0f);
  float c_p_highlights=clampf(p_highlights,-1.0f,1.0f);
  float c_p_high_soft=clampf(p_high_soft,0.0f,2.0f);
  float c_chroma=clampf(chroma,0.0f,2.0f), c_hue=clampf(hue_rotate,-180.0f,180.0f);
  float c_vibrance=clampf(vibrance,-1.0f,1.0f), c_midtone_chroma=clampf(midtone_chroma,0.0f,1.0f);
  float c_cv_gamut=clampf(cv_gamut_compression,0.0f,1.0f);
  float c_cv_threshold=clampf(cv_gamut_threshold,0.50f,0.98f);
  float c_cv_highlight=clampf(cv_highlight_volume,0.0f,1.0f);
  float c_cv_purity=clampf(cv_highlight_purity,0.30f,1.00f);
  float c_cv_start=clampf(cv_highlight_start,-1.0f,4.0f);
  int raw_cv_view=(int)(cv_view+0.5f);int c_cv_view=(raw_cv_view>=0&&raw_cv_view<=3)?raw_cv_view:0;
  int raw_wp=(int)(creative_whitepoint+0.5f);int c_wp=(raw_wp>=0&&raw_wp<=5)?raw_wp:2;
  float c_warm_target=clampf(warm_target,-25.0f,25.0f);
  float c_warm_hue=clampf(warm_hue_shift,-25.0f,25.0f), c_warm_chroma=clampf(warm_chroma,0.50f,1.50f);
  float c_warm_exposure=clampf(warm_exposure,-0.50f,0.50f), c_warm_evenness=clampf(warm_evenness,0.0f,1.0f);
  float c_global_sat=clampf(global_sat,-1.0f,0.0f);
  float c_r_sat=clampf(r_sat,-1.0f,0.0f), c_g_sat=clampf(g_sat,-1.0f,0.0f), c_b_sat=clampf(b_sat,-1.0f,0.0f);
  float c_c_sat=clampf(c_sat,-1.0f,0.0f), c_m_sat=clampf(m_sat,-1.0f,0.0f), c_y_sat=clampf(y_sat,-1.0f,0.0f);
  bool desatch_active=_fabs(c_global_sat)>1e-7f||_fabs(c_r_sat)>1e-7f||_fabs(c_g_sat)>1e-7f||_fabs(c_b_sat)>1e-7f||_fabs(c_c_sat)>1e-7f||_fabs(c_m_sat)>1e-7f||_fabs(c_y_sat)>1e-7f;
  float c_balr=clampf(balance_red,-0.50f,0.50f), c_balg=clampf(balance_green,-0.50f,0.50f), c_balb=clampf(balance_blue,-0.50f,0.50f);
  float c_negcompress=clampf(native_negative_compress,0.0f,1.0f);
  float c_blackclean=clampf(black_gamut_clean,0.0f,1.0f);
  float c_output_skin_protect=clampf(output_skin_protect,0.0f,1.0f);
  float c_gamutclean=_fmaxf(c_negcompress,c_blackclean);
  int raw_heal=(int)(input_gamut_heal+0.5f);int c_heal=raw_heal==1?1:0;
  int raw_logc3ei=(int)(logc3_ei+0.5f);int c_logc3ei=(raw_logc3ei>=0&&raw_logc3ei<=10)?raw_logc3ei:7;

  int raw_sp=(int)(input_space+0.5f);int sp=(raw_sp>=0&&raw_sp<=17)?raw_sp:0;
  int g=0,ti_tf=0;
  if(sp==1){g=1;ti_tf=1;}else if(sp==2){g=2;ti_tf=2;}else if(sp==3){g=3;ti_tf=3;}else if(sp==4){g=4;ti_tf=4;}
  else if(sp==5){g=5;ti_tf=5;}else if(sp==6){g=6;ti_tf=15;}else if(sp==7){g=11;ti_tf=6;}else if(sp==8){g=7;ti_tf=8;}
  else if(sp==9){g=7;ti_tf=9;}else if(sp==10){g=9;ti_tf=10;}else if(sp==11){g=10;ti_tf=13;}else if(sp==12){g=8;ti_tf=11;}
  else if(sp==13){g=8;ti_tf=14;}else if(sp==14){g=0;ti_tf=11;}else if(sp==15){g=12;ti_tf=3;}else if(sp==16){g=10;ti_tf=16;}else if(sp==17){g=10;ti_tf=17;}

  bool base_neutral=c_heal==0&&_fabs(c_temp)<=1e-7f&&_fabs(c_tint)<=1e-7f&&_fabs(c_balr)<=1e-7f&&_fabs(c_balg)<=1e-7f&&_fabs(c_balb)<=1e-7f&&_fabs(c_midtone_chroma)<=1e-7f&&c_cv_gamut<=1e-7f&&c_cv_highlight<=1e-7f&&c_cv_view==0&&c_wp==2&&_fabs(c_p_exposure)<=1e-7f&&_fabs(c_p_bp)<=1e-7f&&_fabs(c_p_contrast-1.0f)<=1e-7f&&_fabs(c_p_pivot)<=1e-7f&&_fabs(c_p_shadows)<=1e-7f&&_fabs(c_p_highlights)<=1e-7f&&c_p_high_soft<=1e-7f&&_fabs(c_chroma-1.0f)<=1e-7f&&_fabs(c_vibrance)<=1e-7f&&_fabs(c_hue)<=1e-7f&&_fabs(c_warm_hue)<=1e-7f&&_fabs(c_warm_chroma-1.0f)<=1e-7f&&_fabs(c_warm_exposure)<=1e-7f&&_fabs(c_warm_evenness)<=1e-7f&&c_negcompress<=1e-7f&&c_blackclean<=1e-7f;
  if(base_neutral){
    if(!desatch_active)return make_float3(p_R,p_G,p_B);
    float3 exact_only=apply_me_desatch_exact(make_float3(p_R,p_G,p_B),c_global_sat,c_r_sat,c_g_sat,c_b_sat,c_c_sat,c_m_sat,c_y_sat);
    return make_float3(finite_or_zero(exact_only.x),finite_or_zero(exact_only.y),finite_or_zero(exact_only.z));
  }
  float3 r=make_float3(p_R,p_G,p_B);

  // Forward technical domain: native decode -> native-linear gain WB -> XYZ D65.
  float3 lin=decode_native_ei(r,ti_tf,c_logc3ei);

  // Temperature/Tint use real per-channel gains in the decoded native-linear gamut.
  // It is intentionally applied before gamut repair and before all tone/color operations.
  if(_fabs(c_temp)>1e-7f||_fabs(c_tint)>1e-7f)lin=linear_gain_wb_native(lin,g,c_temp,c_tint);

  float3 xyz;
  if(g==8){
    if(c_heal==1)lin=rgc_core_ap1(lin);
    xyz=native_linear_to_xyz(lin,g);
  }else{
    xyz=native_linear_to_xyz(lin,g);
    if(c_heal==1)xyz=input_gamut_heal_xyz(xyz);
  }

  // Optional native-RGB channel trims. These remain Keystone controls.
  if(_fabs(c_balr)>1e-7f||_fabs(c_balg)>1e-7f||_fabs(c_balb)>1e-7f)
    xyz=native_rgb_balance_xyz(xyz,g,c_balr,c_balg,c_balb);

  // ============================================================
  // Primera v0.5.5 Exposure / Tone block
  // ============================================================
  // Move from XYZ into the selected native-linear gamut because Primera performs
  // Exposure and Black Point before re-encoding to the selected transfer.
  float3 primera_lin=xyz_to_native_linear(xyz,g);

  // Primera Exposure Stops EXACT:
  // gain = 2^Exposure; RGB *= gain.
  if(_fabs(c_p_exposure)>1e-7f){
    float gain=_powf(2.0f,c_p_exposure);
    primera_lin.x*=gain;
    primera_lin.y*=gain;
    primera_lin.z*=gain;
  }

  // Primera Black Point EXACT.
  if(c_p_bp!=0.0f){
    float knee=0.005f;
    float bp=-c_p_bp;
    primera_lin.x=primera_soft_black_point(primera_lin.x,bp,knee);
    primera_lin.y=primera_soft_black_point(primera_lin.y,bp,knee);
    primera_lin.z=primera_soft_black_point(primera_lin.z,bp,knee);
  }

  // Primera Contrast / Pivot / Shadows / Highlights / Roll Off EXACT equations,
  // routed through Keystone's already-selected transfer function.
  if(_fabs(c_p_contrast-1.0f)>1e-7f||_fabs(c_p_pivot)>1e-7f||
     _fabs(c_p_shadows)>1e-7f||_fabs(c_p_highlights)>1e-7f||c_p_high_soft>1e-7f)
    primera_lin=apply_primera_encoded_tone(
      primera_lin,ti_tf,c_logc3ei,
      c_p_contrast,c_p_pivot,c_p_shadows,c_p_highlights,c_p_high_soft);

  xyz=native_linear_to_xyz(primera_lin,g);

  // Shared color/opponent domain: XYZ D65 -> Oklab. Color-only operations below
  // are returned to XYZ with the current scene Y preserved.
  float color_ref_Y=xyz.y;
  float skin_exposure_mask=0.0f;
  float3 lab=xyz_to_oklab(xyz);
  float L=lab.x;

  // Global Chroma/Hue are pure Oklab operations. Gamut compression is explicit downstream.
  if(_fabs(c_chroma-1.0f)>1e-7f||_fabs(c_hue)>1e-7f){float av=lab.y*c_chroma,bv=lab.z*c_chroma;float ang=c_hue*PI/180.0f,ca=_cosf(ang),sak=_sinf(ang);lab.y=av*ca-bv*sak;lab.z=av*sak+bv*ca;}
  if(_fabs(c_vibrance)>1e-7f)lab=apply_vibrance(lab,c_vibrance,g);


  // Midtone Chroma remains a creative color control. Highlight color handling
  // has moved to the boundary-aware Color Volume section below.
  float current_ev=xyz.y>1.0e-10f?_log2f(xyz.y/0.18f):-20.0f;
  if(c_midtone_chroma>1e-7f){float mdMask=smootherstep(-2.5f,-0.5f,current_ev)*(1.0f-smootherstep(1.0f,3.0f,current_ev));float md=1.0f+c_midtone_chroma*mdMask*0.3f;lab.y*=md;lab.z*=md;}

  // Skin controls in Oklab hue/chroma space. Hue Uniformity converges selected skin hues toward Target without spatial smoothing.
  bool skin_primary_active=_fabs(c_warm_hue)>1e-7f||_fabs(c_warm_chroma-1.0f)>1e-7f||_fabs(c_warm_exposure)>1e-7f;
  float skin_even_eff=c_warm_evenness*c_warm_evenness;
  bool skin_even_active=skin_even_eff>1e-7f;
  if(skin_primary_active||skin_even_active){
    float sk_dg=smootherstep(0.02f,0.18f,L),sk_bg=1.0f-smootherstep(1.0f,1.5f,L);
    float sk_lw=sk_dg*sk_bg;
    if(sk_lw>1e-8f){
      float skin_center=SKIN_BASE_CENTER+deg_to_rad(c_warm_target);
      if(skin_primary_active){float sk_c=_sqrtf(lab.y*lab.y+lab.z*lab.z);float sk_h=sk_c>0.0f?mod2(_atan2f(lab.z,lab.y),2.0f*PI):0.0f;float sk_a=skin_alpha(sk_h,skin_center);float hue_adj=sk_a*deg_to_rad(c_warm_hue);float sat_adj=1.0f+sk_a*(c_warm_chroma-1.0f);float3 lab_skin=make_float3(lab.x,(sk_c*sat_adj)*_cosf(sk_h+hue_adj),(sk_c*sat_adj)*_sinf(sk_h+hue_adj));float sk_nm=smootherstep(0.0f,0.1f,sk_c)*sk_lw;skin_exposure_mask=_fmaxf(skin_exposure_mask,sk_a*sk_nm);lab=lab+(lab_skin-lab)*sk_nm;}
      if(skin_even_active){
        float sk_ec=_sqrtf(lab.y*lab.y+lab.z*lab.z);
        float sk_eh=sk_ec>0.0f?mod2(_atan2f(lab.z,lab.y),2.0f*PI):0.0f;
        float sk_esel=skin_alpha(sk_eh,skin_center);
        float sk_emask=sk_esel*smootherstep(0.015f,0.080f,sk_ec)*sk_lw;
        if(sk_emask>0.0f){
          float sk_edelta=_atan2f(_sinf(skin_center-sk_eh),_cosf(skin_center-sk_eh));
          float sk_estrength=0.55f*skin_even_eff*sk_emask;
          float sk_eout=sk_eh+sk_edelta*sk_estrength;
          lab.y=sk_ec*_cosf(sk_eout);
          lab.z=sk_ec*_sinf(sk_eout);
        }
      }
    }
  }

  float3 graded_xyz=oklab_to_xyz_preserve_y_safe(lab,color_ref_Y);
  if(_fabs(c_warm_exposure)>1e-7f&&skin_exposure_mask>1e-8f){float k=_powf(2.0f,c_warm_exposure*skin_exposure_mask);graded_xyz*=make_float3(k,k,k);}

  // ============================================================
  // COLOR VOLUME
  // ============================================================
  // Diagnostics measure the fully graded state before Color Volume modifies it.
  float3 cv_before=graded_xyz;
  float cv_stress=cv_native_stress_ratio(cv_before,g);
  float cv_hi_stress=ks_cv_highlight_stress(cv_before,g,c_cv_purity,c_cv_start);

  // Picture-formation-inspired purity management, intentionally WITHOUT a display
  // tone scale or peak-nit assumption. Highlight volume runs first; technical
  // gamut compression then catches colors approaching or exceeding native gamut.
  if(c_cv_highlight>1e-7f)
    graded_xyz=cv_apply_highlight_volume(graded_xyz,g,c_cv_highlight,c_cv_purity,c_cv_start);
  if(c_cv_gamut>1e-7f)
    graded_xyz=cv_apply_gamut_compression(graded_xyz,g,c_cv_gamut,c_cv_threshold);

  float cv_comp=cv_compression_amount(cv_before,graded_xyz,g);

  if(c_cv_view==1){
    // 0 at low stress, white at/outside the native chromaticity boundary.
    float m=smootherstep(c_cv_threshold,1.0f,cv_stress);
    return cv_debug_mask(m,g,ti_tf,c_logc3ei);
  }
  if(c_cv_view==2)return cv_debug_mask(cv_comp,g,ti_tf,c_logc3ei);
  if(c_cv_view==3)return cv_debug_mask(cv_hi_stress,g,ti_tf,c_logc3ei);

  // OpenDRT-style Creative White adaptation, pre-ODT approximation.
  if(c_wp!=2)graded_xyz=odrt_creative_white_preodt(graded_xyz,c_wp);

  // Output cleanup. White and black neutralization are independent and preserve
  // scene Y. Skin Protect attenuates only the creative neutralization. The technical
  // native negative-primary repair remains active at full requested strength so skin
  // is never "protected" into invalid negative native RGB.
  // No palette matrix, RGB crosstalk, hue rotation, or global saturation look.
  float output_skin_mask=0.0f;
  if(c_output_skin_protect>1e-7f&&(c_negcompress>1e-7f||c_blackclean>1e-7f))
    output_skin_mask=output_skin_mask_xyz(graded_xyz,c_warm_target);
  float output_skin_keep=1.0f-clampf(c_output_skin_protect*output_skin_mask,0.0f,1.0f);
  float white_clean_amt=c_negcompress*output_skin_keep;
  float black_clean_amt=c_blackclean*output_skin_keep;
  if(white_clean_amt>1e-7f)graded_xyz=clean_neutral_highlights_xyz(graded_xyz,white_clean_amt);
  if(black_clean_amt>1e-7f)graded_xyz=clean_neutral_shadows_xyz(graded_xyz,black_clean_amt);
  float3 cam=xyz_to_native_linear(graded_xyz,g);
  cam=technical_encode_domain_guard(cam,graded_xyz.y);
  if(c_gamutclean>1e-7f){float3 safe=compress_to_gamut(cam,graded_xyz.y);cam=cam+(safe-cam)*c_gamutclean;}
  float3 result=encode_native_ei(cam,ti_tf,c_logc3ei);
  if(desatch_active)result=apply_me_desatch_exact(result,c_global_sat,c_r_sat,c_g_sat,c_b_sat,c_c_sat,c_m_sat,c_y_sat);

  // Last-resort finite guard only. Validation must fail on any upstream NaN/Inf before this point.
  float nx=finite_or_zero(result.x);
  float ny=finite_or_zero(result.y);
  float nz=finite_or_zero(result.z);
  return make_float3(nx,ny,nz);
}
